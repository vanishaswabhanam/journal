---
// The right-hand info panel on a product page: name, price, buy button,
// then a description/detail panel. Sticky on desktop so it stays in view
// while scrolling a long photo gallery.
import type { Journal } from '../lib/journals';
import { site } from '../site.config';

interface Props {
  journal: Journal;
}

const { journal } = Astro.props;

// Material is already shown as the eyebrow above the name, so it isn't
// repeated here — this is just the extra `details` rows, if any.
const rows = journal.details;

// A journal with its own `buyLink` skips the cart and just links out
// (Etsy, an Instagram DM, wherever) — see CONTENT.md. Otherwise the
// button adds it to the cart; Cart.astro picks up any button anywhere on
// the site with this data attribute, so no extra wiring is needed here.
const cartItem = JSON.stringify({
  slug: journal.slug,
  name: journal.name,
  price: journal.price,
  image: journal.hero ?? journal.image,
});
---

<div class="info">
  {journal.material && <p class="info__eyebrow">{journal.material}</p>}
  <h1 class="info__name">{journal.name}</h1>
  <p class="info__price">${journal.price}</p>
  <p class="info__note">One of one — hand-stitched, not mass-produced.</p>

  <div class="info__purchase">
    {journal.sold ? (
      <p class="info__buy info__buy--sold">Sold out</p>
    ) : journal.buyLink ? (
      <a class="info__buy" href={journal.buyLink}>
        <span>{site.buy.label}</span>
        <span class="info__buy-arrow" aria-hidden="true">&rarr;</span>
      </a>
    ) : (
      <button type="button" class="info__buy" data-add-to-cart={cartItem}>
        <span>Add to cart</span>
        <span class="info__buy-arrow" aria-hidden="true">&rarr;</span>
      </button>
    )}

    {!journal.sold && !journal.buyLink && site.venmo?.username && (
      <div class="info__venmo">
        <p class="info__venmo-label">Or pay via Venmo</p>
        <p class="info__venmo-detail">
          <strong>@{site.venmo.username}</strong> · <strong>${journal.price}</strong> · note: "{journal.name}"
        </p>
        <button
          type="button"
          class="info__venmo-copy"
          data-copy={`@${site.venmo.username} — $${journal.price} — ${journal.name}`}
        >
          Copy payment details
        </button>
        <span class="info__venmo-copied" role="status" aria-live="polite"></span>
      </div>
    )}
  </div>

  {(journal.description || rows.length > 0) && (
    <div class="info__panel">
      {journal.description && <p class="info__description">{journal.description}</p>}
      {rows.length > 0 && (
        <dl class="info__rows">
          {rows.map((row) => (
            <div class="info__row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  )}
</div>

<script>
  // Venmo has no "pay this exact page" web checkout — only its app, on a
  // phone, can open to a pre-filled payment screen. Rather than a button
  // that quietly does nothing on desktop (and works, sometimes, on
  // mobile), every device gets the exact same thing: the payment details
  // spelled out, with one button that copies them — "copy" behaves
  // identically everywhere, unlike a deep link.
  function initVenmoCopy() {
    document.querySelectorAll<HTMLButtonElement>('.info__venmo-copy').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = 'true';

      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        const status = btn.parentElement?.querySelector('.info__venmo-copied');
        try {
          await navigator.clipboard.writeText(text);
          if (status) status.textContent = 'Copied!';
        } catch {
          if (status) status.textContent = 'Could not copy — select and copy the text above instead.';
        }
        window.setTimeout(() => {
          if (status) status.textContent = '';
        }, 2500);
      });
    });
  }

  initVenmoCopy();
  document.addEventListener('astro:page-load', initVenmoCopy);
</script>

<style>
  .info {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .info__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .info__name {
    margin: 0 0 0.6rem;
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 5.5vw, 4.25rem);
    line-height: 0.92;
    letter-spacing: 0.005em;
  }

  .info__price {
    margin: 0 0 0.9rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
  }

  .info__note {
    margin: -0.4rem 0 1.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .info__purchase {
    margin-bottom: 2.25rem;
  }

  .info__buy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    padding: 1rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #f4f4f2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .info__buy-arrow {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  @media (hover: hover) {
    .info__buy:hover {
      background: #2a2a2a;
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
    }

    .info__buy:hover .info__buy-arrow {
      transform: translateX(3px);
    }
  }

  .info__buy:active {
    transform: translateY(0);
  }

  .info__buy--sold,
  .info__buy:disabled {
    display: block;
    background: transparent;
    border-color: var(--line-soft);
    color: var(--muted);
    cursor: default;
    transform: none;
    box-shadow: none;
  }

  /* Deliberately quieter than the main buy button — a plain hairline box,
     not a second competing CTA — and identical on every device. Venmo
     has no web checkout to link to, so rather than a button that works
     on some phones and does nothing on desktop, everyone gets the same
     thing: the payment details spelled out, with a copy button that
     behaves exactly the same everywhere. */
  .info__venmo {
    margin-top: 0.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-soft);
  }

  .info__venmo-label {
    margin: 0 0 0.35rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .info__venmo-detail {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
  }

  .info__venmo-copy {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 1rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    text-align: center;
    text-transform: uppercase;
    font-family: inherit;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }

  @media (hover: hover) {
    .info__venmo-copy:hover {
      border-color: var(--ink);
    }
  }

  .info__venmo-copied {
    display: block;
    margin-top: 0.5rem;
    min-height: 1em;
    font-size: 0.78rem;
    color: var(--muted);
    text-align: center;
  }

  /* A hairline box, same weight and color as the shop grid's cell borders
     — this panel reads as "one more cell," not a different material. */
  .info__panel {
    border: 1px solid var(--line);
    padding: 1.5rem;
  }

  .info__description {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.75;
    color: #333;
  }

  .info__rows {
    margin: 1.5rem 0 0;
  }

  .info__rows:first-child {
    margin-top: 0;
  }

  .info__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line-soft);
    font-size: 0.8rem;
  }

  .info__row:first-child {
    border-top: none;
  }

  .info__row dt {
    min-width: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .info__row dd {
    min-width: 0;
    margin: 0;
    text-align: right;
  }

  @media (max-width: 860px) {
    .info {
      position: static;
    }
  }
</style>
