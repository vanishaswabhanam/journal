---
// The right-hand info panel on a product page: name, price, buy button,
// then a bordered panel with the description and material/detail rows.
import type { Journal } from '../lib/journals';
import { site } from '../site.config';

interface Props {
  journal: Journal;
}

const { journal } = Astro.props;

const buyHref = journal.buyLink ?? site.buy.href;
const rows = [
  ...(journal.material ? [{ label: 'Material', value: journal.material }] : []),
  ...journal.details,
];
---

<div class="info">
  <h1 class="info__name">{journal.name}</h1>
  <p class="info__price">${journal.price}</p>

  {journal.sold ? (
    <p class="info__buy info__buy--sold">Sold out</p>
  ) : (
    <a class="info__buy" href={buyHref}>{site.buy.label}</a>
  )}

  {(journal.description || rows.length > 0) && (
    <div class="info__panel">
      {journal.description && <p class="info__description">{journal.description}</p>}
      {rows.length > 0 && (
        <dl class="info__rows">
          {rows.map((row) => (
            <div class="info__row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  )}
</div>

<style>
  .info__name {
    margin: 0 0 0.4rem;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
  }

  .info__price {
    margin: 0 0 1.5rem;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: 1.15rem;
  }

  .info__buy {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 2rem;
    padding: 0.9rem 1rem;
    border: 1px solid #111;
    background: #111;
    color: #f4f4f2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  .info__buy:hover {
    background: #2a2a2a;
  }

  .info__buy--sold {
    background: transparent;
    border-color: var(--line);
    color: #666;
  }

  .info__panel {
    border: 1px solid var(--line);
    padding: 1.25rem;
  }

  .info__description {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .info__rows {
    margin: 1.25rem 0 0;
  }

  .info__rows:first-child {
    margin-top: 0;
  }

  .info__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
  }

  .info__row:first-child {
    border-top: none;
  }

  .info__row dt {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #666;
  }

  .info__row dd {
    margin: 0;
    text-align: right;
  }
</style>
