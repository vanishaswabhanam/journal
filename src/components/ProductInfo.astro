---
// The right-hand info panel on a product page: name, price, buy button,
// then a description/detail panel. Sticky on desktop so it stays in view
// while scrolling a long photo gallery.
import type { Journal } from '../lib/journals';
import { site } from '../site.config';
import { venmoPayLink } from '../lib/venmo';

interface Props {
  journal: Journal;
}

const { journal } = Astro.props;

// Material is already shown as the eyebrow above the name, so it isn't
// repeated here — this is just the extra `details` rows, if any.
const rows = journal.details;

// A journal with its own `buyLink` skips the cart and just links out
// (Etsy, an Instagram DM, wherever) — see CONTENT.md. Otherwise the
// button adds it to the cart; Cart.astro picks up any button anywhere on
// the site with this data attribute, so no extra wiring is needed here.
const cartItem = JSON.stringify({
  slug: journal.slug,
  name: journal.name,
  price: journal.price,
  image: journal.hero ?? journal.image,
});
---

<div class="info">
  {journal.material && <p class="info__eyebrow">{journal.material}</p>}
  <h1 class="info__name">{journal.name}</h1>
  <p class="info__price">${journal.price}</p>
  <p class="info__note">One of one — hand-stitched, not mass-produced.</p>

  <div class="info__purchase">
    {journal.sold ? (
      <p class="info__buy info__buy--sold">Sold out</p>
    ) : journal.buyLink ? (
      <a class="info__buy" href={journal.buyLink}>
        <span>{site.buy.label}</span>
        <span class="info__buy-arrow" aria-hidden="true">&rarr;</span>
      </a>
    ) : (
      <button type="button" class="info__buy" data-add-to-cart={cartItem}>
        <span>Add to cart</span>
        <span class="info__buy-arrow" aria-hidden="true">&rarr;</span>
      </button>
    )}

    {!journal.sold && !journal.buyLink && site.venmo?.username && (
      <div class="info__venmo">
        {/* Touch devices (phones/tablets) only: a clean one-tap action,
            written with no hedging about desktop at all. */}
        <a
          class="info__venmo-btn info__venmo-btn--touch"
          href={venmoPayLink(site.venmo.username, journal.price, journal.name)}
        >
          Pay with Venmo — ${journal.price}
        </a>
        <p class="info__venmo-hint info__venmo-hint--touch">Opens the Venmo app, pre-filled.</p>

        {/* Mouse/trackpad devices only: Venmo has no desktop app or web
            checkout, so there's nothing for a button to open here — plain
            instructions instead, written for this platform specifically. */}
        <p class="info__venmo-label info__venmo-label--desktop">Or pay via Venmo</p>
        <p class="info__venmo-hint info__venmo-hint--desktop">
          Send <strong>${journal.price}</strong> to <strong>@{site.venmo.username}</strong> in the
          Venmo app, with the note "{journal.name}".
        </p>
      </div>
    )}
  </div>

  {(journal.description || rows.length > 0) && (
    <div class="info__panel">
      {journal.description && <p class="info__description">{journal.description}</p>}
      {rows.length > 0 && (
        <dl class="info__rows">
          {rows.map((row) => (
            <div class="info__row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  )}
</div>

<style>
  .info {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .info__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .info__name {
    margin: 0 0 0.6rem;
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 5.5vw, 4.25rem);
    line-height: 0.92;
    letter-spacing: 0.005em;
  }

  .info__price {
    margin: 0 0 0.9rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
  }

  .info__note {
    margin: -0.4rem 0 1.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .info__purchase {
    margin-bottom: 2.25rem;
  }

  .info__buy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    padding: 1rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #f4f4f2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .info__buy-arrow {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  @media (hover: hover) {
    .info__buy:hover {
      background: #2a2a2a;
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
    }

    .info__buy:hover .info__buy-arrow {
      transform: translateX(3px);
    }
  }

  .info__buy:active {
    transform: translateY(0);
  }

  .info__buy--sold,
  .info__buy:disabled {
    display: block;
    background: transparent;
    border-color: var(--line-soft);
    color: var(--muted);
    cursor: default;
    transform: none;
    box-shadow: none;
  }

  /* Deliberately styled as the quieter, secondary option — outlined, not
     filled — so it reads as an alternative to the main buy button above,
     not a second competing CTA of equal weight.

     Two entirely separate versions, each written for one platform only,
     toggled with a single CSS signal rather than one block hedging to
     cover both: `pointer: coarse` is true for a touchscreen (phone/
     tablet — where the Venmo app might actually open) and false for a
     mouse/trackpad (desktop, where Venmo has no app or web checkout to
     open at all). Default to the desktop version; the touch block only
     shows up inside the matching media query below. */
  .info__venmo {
    margin-top: 0.75rem;
  }

  /* Compound selectors (both classes together) rather than the modifier
     class alone — .info__venmo-btn already sets display: block, and a
     single-class .info__venmo-btn--touch rule has equal specificity, so
     which one wins would come down to source order instead of the media
     query actually being the deciding factor. Chaining both classes
     raises the specificity enough to always win, regardless of order. */
  .info__venmo-btn.info__venmo-btn--touch,
  .info__venmo-hint.info__venmo-hint--touch {
    display: none;
  }

  .info__venmo-btn {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-family: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    transition: border-color 0.2s var(--ease);
  }

  @media (hover: hover) {
    .info__venmo-btn:hover {
      border-color: var(--ink);
    }
  }

  .info__venmo-label {
    margin: 0 0 0.35rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .info__venmo-hint {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .info__venmo-hint--desktop {
    margin-top: 0;
  }

  @media (pointer: coarse) {
    /* Compound again, to beat the compound hide-rule above at equal
       specificity (being inside a media query doesn't add specificity
       on its own — only the selector does). */
    .info__venmo-btn.info__venmo-btn--touch,
    .info__venmo-hint.info__venmo-hint--touch {
      display: block;
    }

    /* These two have no competing display declaration anywhere else, so
       a single-class selector is enough — no specificity tie to worry
       about. */
    .info__venmo-label--desktop,
    .info__venmo-hint--desktop {
      display: none;
    }
  }

  /* A hairline box, same weight and color as the shop grid's cell borders
     — this panel reads as "one more cell," not a different material. */
  .info__panel {
    border: 1px solid var(--line);
    padding: 1.5rem;
  }

  .info__description {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.75;
    color: #333;
  }

  .info__rows {
    margin: 1.5rem 0 0;
  }

  .info__rows:first-child {
    margin-top: 0;
  }

  .info__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line-soft);
    font-size: 0.8rem;
  }

  .info__row:first-child {
    border-top: none;
  }

  .info__row dt {
    min-width: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .info__row dd {
    min-width: 0;
    margin: 0;
    text-align: right;
  }

  @media (max-width: 860px) {
    .info {
      position: static;
    }
  }
</style>
