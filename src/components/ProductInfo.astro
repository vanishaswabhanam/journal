---
// The right-hand info panel on a product page: name, price, buy button,
// then a description/detail panel. Sticky on desktop so it stays in view
// while scrolling a long photo gallery.
import type { Journal } from '../lib/journals';
import { site } from '../site.config';

interface Props {
  journal: Journal;
}

const { journal } = Astro.props;

// Material is already shown as the eyebrow above the name, so it isn't
// repeated here — this is just the extra `details` rows, if any.
const rows = journal.details;

// A journal with its own `buyLink` skips the cart and just links out
// (Etsy, an Instagram DM, wherever) — see CONTENT.md. Otherwise the
// button adds it to the cart; Cart.astro picks up any button anywhere on
// the site with this data attribute, so no extra wiring is needed here.
const cartItem = JSON.stringify({
  slug: journal.slug,
  name: journal.name,
  price: journal.price,
  image: journal.hero ?? journal.image,
});
---

<div class="info">
  {journal.material && <p class="info__eyebrow">{journal.material}</p>}
  <h1 class="info__name">{journal.name}</h1>
  <p class="info__price">${journal.price}</p>
  <p class="info__note">One of one — hand-stitched, not mass-produced.</p>

  {journal.sold ? (
    <p class="info__buy info__buy--sold">Sold out</p>
  ) : journal.buyLink ? (
    <a class="info__buy" href={journal.buyLink}>
      <span>{site.buy.label}</span>
      <span class="info__buy-arrow" aria-hidden="true">&rarr;</span>
    </a>
  ) : (
    <button type="button" class="info__buy" data-add-to-cart={cartItem}>
      <span>Add to cart</span>
      <span class="info__buy-arrow" aria-hidden="true">&rarr;</span>
    </button>
  )}

  {(journal.description || rows.length > 0) && (
    <div class="info__panel">
      {journal.description && <p class="info__description">{journal.description}</p>}
      {rows.length > 0 && (
        <dl class="info__rows">
          {rows.map((row) => (
            <div class="info__row">
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  )}
</div>

<style>
  .info {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .info__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .info__name {
    margin: 0 0 0.5rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.15;
  }

  .info__price {
    margin: 0 0 0.9rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
  }

  .info__note {
    margin: -0.4rem 0 1.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .info__buy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 2.25rem;
    padding: 1rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #f4f4f2;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  .info__buy-arrow {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  @media (hover: hover) {
    .info__buy:hover {
      background: #2a2a2a;
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
    }

    .info__buy:hover .info__buy-arrow {
      transform: translateX(3px);
    }
  }

  .info__buy:active {
    transform: translateY(0);
  }

  .info__buy--sold {
    display: block;
    background: transparent;
    border-color: var(--line-soft);
    color: var(--muted);
  }

  .info__panel {
    border-top: 1px solid var(--line-soft);
    padding-top: 1.5rem;
  }

  .info__description {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.75;
    color: #333;
  }

  .info__rows {
    margin: 1.5rem 0 0;
  }

  .info__rows:first-child {
    margin-top: 0;
  }

  .info__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line-soft);
    font-size: 0.8rem;
  }

  .info__row:first-child {
    border-top: none;
  }

  .info__row dt {
    min-width: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .info__row dd {
    min-width: 0;
    margin: 0;
    text-align: right;
  }

  @media (max-width: 860px) {
    .info {
      position: static;
    }
  }
</style>
