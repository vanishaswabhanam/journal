---
// The "other cool stuff" tab's grid: every entry in src/content/grid/
// with `category: pouch`, in the same order rules as the journals (sold
// ones sink to the back), drawn with the same card as a journal
// (JournalCard.astro, which gives pouches a wider picture box). Same cell
// shape and dividing lines as Grid.astro (duplicated below, not imported,
// since Astro scopes component styles — see that file for the canonical
// version of this shape) so switching tabs never shifts the layout.
import JournalCard from './JournalCard.astro';
import { getPouches } from '../lib/journals';

const pouches = await getPouches();
---

<div class="grid">
  {pouches.map((pouch) => (
    <div class="grid__cell">
      <JournalCard entry={pouch} />
    </div>
  ))}
</div>

<style>
  /* Identical to Grid.astro's .grid/.grid__cell — see that file for why
     each rule is shaped this way (the vertical-line background trick and
     its 300px upward stretch for the bounce gap, the grid's own
     border-bottom for a partial last row, the top border left to
     whatever sits directly above). */
  .grid {
    --cols: 3;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    padding-top: 300px;
    margin-top: -300px;
    border-bottom: 1px solid var(--line);
    background-repeat: no-repeat;
    background-size: 1px 100%;
    background-image: linear-gradient(var(--line), var(--line)), linear-gradient(var(--line), var(--line)), linear-gradient(var(--line), var(--line)),
      linear-gradient(var(--line), var(--line));
    background-position:
      0 0,
      calc(100% / var(--cols)) 0,
      calc(200% / var(--cols)) 0,
      100% 0;
  }

  .grid__cell {
    position: relative;
    aspect-ratio: 668 / 570;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 720px) {
    .grid {
      --cols: 2;
    }

    .grid__cell {
      aspect-ratio: 1 / 1;
    }
  }
</style>
