---
// The "other cool stuff" tab's grid. Same cell shape and dividing lines as
// Grid.astro (duplicated here, not imported, since Astro scopes component
// styles — see that file for the canonical version of this shape) so
// switching tabs never shifts the layout.
//
// These six are placeholders: there are no real non-journal products yet,
// so each cell shows a simple line star and a "Coming soon" label instead
// of a photo and a price, and none of them link anywhere. Replace this
// with real entries (and give them their own product pages, same as
// journals) once there's actual stock to show.
const placeholders = Array.from({ length: 6 });

const star = '<polygon points="50,8 61,38 93,38 67,57 77,88 50,69 23,88 33,57 7,38 39,38" />';
---

<div class="grid">
  {placeholders.map(() => (
    <div class="grid__cell">
      <div class="other-card">
        <p class="other-card__label">Coming soon</p>
        <div class="other-card__symbol-wrap">
          <svg
            class="other-card__symbol"
            viewBox="0 0 100 100"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
            stroke-linecap="round"
            set:html={star}
          />
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  /* Identical to Grid.astro's .grid/.grid__cell — see that file for why
     each rule is shaped this way (the vertical-line background trick, the
     grid's own border-bottom for a partial last row, the top border left
     to whatever sits directly above). */
  .grid {
    --cols: 3;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    border-bottom: 1px solid var(--line);
    background-repeat: no-repeat;
    background-size: 1px 100%;
    background-image: linear-gradient(var(--line), var(--line)), linear-gradient(var(--line), var(--line)), linear-gradient(var(--line), var(--line)),
      linear-gradient(var(--line), var(--line));
    background-position:
      0 0,
      calc(100% / var(--cols)) 0,
      calc(200% / var(--cols)) 0,
      100% 0;
  }

  .grid__cell {
    position: relative;
    aspect-ratio: 668 / 570;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 720px) {
    .grid {
      --cols: 2;
    }

    .grid__cell {
      aspect-ratio: 1 / 1;
    }
  }

  .other-card {
    position: absolute;
    inset: 0;
    color: var(--muted);
  }

  .other-card__label {
    position: absolute;
    top: 5.4%;
    left: 4.3%;
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(0.85rem, 1.05vw, 1.4rem);
    line-height: 1;
    color: var(--muted);
  }

  .other-card__symbol-wrap {
    position: absolute;
    top: 48.6%;
    left: 50%;
    height: 38%;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .other-card__symbol {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 720px) {
    .other-card__symbol-wrap {
      height: 32%;
    }
  }
</style>
