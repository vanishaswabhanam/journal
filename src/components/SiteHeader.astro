---
// Fixed site header. The three nav "words" used to be images (the shop's
// original brand assets) — turns out those PNGs were just set in Anton
// (the font --display already uses elsewhere on the site), so they're real
// text now, styled to match the old images almost exactly: same font,
// same weight, with letter-spacing and a tiny vertical nudge tuned by
// overlaying this against the old PNGs pixel-for-pixel. See
// .site-header__word below for the exact numbers.
// Add a fourth nav item by adding an entry below — no image to make.
//
// The cart lives inside the last nav slot, next to Contact, rather than as
// its own evenly-spaced item — that keeps the three words' spacing exactly
// as designed instead of a fourth big item crowding them apart. It's
// rendered here rather than in BaseLayout so it's defined in one place.
// Cart contents persist across page loads via localStorage, not via
// transition:persist — see Cart.astro.
//
// The header itself is NOT transition:persist. It was, briefly, so it
// would survive an Astro page transition as the same DOM node instead of
// a fresh one — but it looks identical on every page regardless, so
// nothing was actually gained, and clicking a nav link (inside the
// persisted header, navigating to a page that also has a persisted
// header) visibly glitched in a way clicking a journal card (outside the
// header) never did. Plain, non-persisted is both simpler and the fix.
import Cart from './Cart.astro';

const navItems = [{ href: '/', label: 'Shop' }];
const contact = { href: '/contact', label: 'Contact' };
---

<header class="site-header">
  <nav class="site-header__nav">
    {/* A real logo file now (public/images/nav/hide-st-logo.png) — a
        supplied PNG, not CSS text, so it's rendered as an <img> rather
        than through .site-header__word like "Shop"/"Contact". Cropped
        tight to its own ink (no padding baked in) before landing here,
        so its height alone controls how big it reads next to them. */}
    <a href="/journal" class="site-header__link">
      <img src="/images/nav/hide-st-logo.png" alt="Hide St." class="site-header__logo" />
    </a>
    {navItems.map((item) => (
      <a href={item.href} class="site-header__link">
        <span class="site-header__word">{item.label}</span>
      </a>
    ))}
    <div class="site-header__end">
      <a href={contact.href} class="site-header__link">
        <span class="site-header__word">{contact.label}</span>
      </a>
      <Cart />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--header-height);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .site-header__nav {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .site-header__link {
    display: flex;
    align-items: center;
    height: var(--nav-word-height);
    text-decoration: none;
  }

  /* Matches the old journal-word/shop-word/contact-word.png assets: same
     font (Anton, --display), same weight, lined up by overlaying this
     directly on top of the old PNGs. Sized up from that match via
     font-size directly (not a scaleY stretch — that grows height only,
     leaving the letters tall and skinny instead of proportionally
     bigger) by the same ratio (×1.152) the old scaleY(1.16) stretch used
     to add on top of the 0.993 base, so the overall height lands the
     same as before, just with normal letterforms. */
  .site-header__word {
    display: block;
    position: relative;
    top: calc(var(--nav-word-height) * 0.018);
    font-family: var(--display);
    text-transform: uppercase;
    font-size: calc(var(--nav-word-height) * 1.1);
    line-height: 1;
    letter-spacing: -0.053em;
    color: var(--ink);
    white-space: nowrap;
    -webkit-text-stroke: calc(var(--nav-word-height) * 0.0018) var(--bg);
  }

  .site-header__logo {
    display: block;
    height: calc(var(--nav-word-height) * 1.1);
    width: auto;
  }
</style>
