---
// Fixed site header. The three nav "words" are images (the shop's original
// brand assets), not text — see public/images/nav/. They are trimmed to
// their visible pixels, so every word is sized by the same height and the
// widths follow from each word's own proportions.
// Add a fourth wordmark nav item by adding an entry below and dropping a
// trimmed PNG in public/images/nav/.
//
// The cart lives inside the last nav slot, next to Contact, rather than as
// its own evenly-spaced item — that keeps the three wordmarks' spacing
// exactly as designed instead of a fourth big item crowding them apart.
// It's rendered here (inside this persisted header) rather than in
// BaseLayout so its state — is the drawer open, what's in it — survives
// page navigations without flickering. See Cart.astro.
import Cart from './Cart.astro';

const navItems = [
  { href: '/journal', src: '/images/nav/journal-word.png', alt: 'Journal' },
  { href: '/', src: '/images/nav/shop-word.png', alt: 'Shop' },
];
const contact = { href: '/contact', src: '/images/nav/contact-word.png', alt: 'Contact' };
---

<header class="site-header" transition:persist transition:name="site-header">
  <nav class="site-header__nav">
    {navItems.map((item) => (
      <a href={item.href} class="site-header__link">
        <img src={item.src} alt={item.alt} class="site-header__word" />
      </a>
    ))}
    <div class="site-header__end">
      <a href={contact.href} class="site-header__link">
        <img src={contact.src} alt={contact.alt} class="site-header__word" />
      </a>
      <Cart />
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--header-height);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .site-header__nav {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  .site-header__link {
    display: block;
    line-height: 0;
  }

  .site-header__word {
    display: block;
    height: var(--nav-word-height);
    width: auto;
    max-width: none;
  }
</style>
