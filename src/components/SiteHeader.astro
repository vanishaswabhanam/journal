---
// Fixed site header. The three nav "words" are images (from the shop's
// original brand assets), not text — see public/images/nav/.
// Add a fourth nav item by copying one <a> block and dropping a new image
// in public/images/nav/.
const navItems = [
  { href: '/journal', src: '/images/nav/journal-word.png', alt: 'Journal' },
  { href: '/', src: '/images/nav/shop-word.png', alt: 'Shop' },
  { href: '/contact', src: '/images/nav/contact-word.png', alt: 'Contact' },
];
---

<header class="site-header">
  <nav class="site-header__nav">
    {navItems.map((item) => (
      <a href={item.href} class="site-header__link">
        <img src={item.src} alt={item.alt} class="site-header__word" />
      </a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  .site-header__nav {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 clamp(1rem, 4vw, 3rem);
  }

  .site-header__link {
    display: block;
    line-height: 0;
  }

  .site-header__word {
    display: block;
    height: clamp(2.25rem, 6vw, 4.5rem);
    width: auto;
    max-width: 30vw;
    object-fit: contain;
  }
</style>
