---
// The shop page's tab bar: "journals" (the real product grid) vs "other
// cool stuff" (placeholder non-journal items — see OtherGrid.astro).
//
// Always starts on "journals", every time — server-rendered that way, not
// remembered across visits, so there's no localStorage/JS needed to land
// on the right tab. Landing on "/" is itself a fresh server render (and a
// ClientRouter navigation here swaps in a fresh one too, it isn't
// transition:persist), so this default just falls out of the markup below
// without any extra logic.
import Grid from './Grid.astro';
import OtherGrid from './OtherGrid.astro';
---

<div class="shop-tabs">
  <div class="shop-tabs__track">
    <div class="shop-tabs__room" aria-hidden="true"></div>
    <div class="shop-tabs__bar" role="tablist">
      <button
        type="button"
        class="shop-tabs__tab is-active"
        id="shop-tab-journals"
        role="tab"
        aria-selected="true"
        aria-controls="shop-panel-journals"
        data-tab="journals"
      >
        journals
      </button>
      <button
        type="button"
        class="shop-tabs__tab"
        id="shop-tab-other"
        role="tab"
        aria-selected="false"
        aria-controls="shop-panel-other"
        data-tab="other"
      >
        other cool stuff
      </button>
    </div>
  </div>

  <div id="shop-panel-journals" role="tabpanel" aria-labelledby="shop-tab-journals">
    <Grid />
  </div>
  <div id="shop-panel-other" role="tabpanel" aria-labelledby="shop-tab-other" hidden>
    <OtherGrid />
  </div>
</div>

<style>
  /* Matches the product grid's own 3-column math exactly (same
     full-bleed repeat(3, 1fr), no outer gutter — see Grid.astro) so the
     two tab labels land precisely on top of the grid's two vertical
     divider lines below, the way Vanisha's own reference mockup placed
     them — not just left-aligned with a gap between them. Spanning two
     adjacent columns and centering within that span puts the label
     exactly on the shared boundary: centered across columns 1-2 lands on
     the first divider, centered across columns 2-3 lands on the second. */
  /* The bar's height, fixed rather than content-sized, because the
     sticky math below needs it. This is the height the bar had with the
     old, bigger labels, so shrinking the text didn't shrink the bar. */
  .shop-tabs {
    --tabs-height: calc(2rem + clamp(1.25rem, 1.5vw, 1.65rem) + 1px);
  }

  /* Scrolling down, the bar scrolls away with the page like normal.
     But when the page is pulled down past the top and bounces (iOS, and
     trackpad overscroll), it should hold still under the header like the
     header does, instead of riding the bounce down with the grid.

     That's a sticky *bottom* edge: it stops the bar from ever sitting
     lower than its own resting spot (right under the header), and does
     nothing to stop it moving up. A bounce is the only time the page
     tries to push it lower, so that's the only time it engages. It's
     handled by the browser's own scrolling, so it moves as smoothly as
     the bounce itself, no scroll-event JS.

     A sticky element can only shift within its parent, and at rest the
     bar is at its parent's very top, with nowhere to shift up to. So the
     track starts 300px higher (negative margin) with an empty spacer
     filling that space, which hides behind the fixed header. */
  .shop-tabs__track {
    margin-top: -300px;
  }

  .shop-tabs__room {
    height: 300px;
    pointer-events: none;
  }

  .shop-tabs__bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* center, not baseline — baseline aligned the two labels by their
       text line instead of their visual middle, so the smaller inactive
       label read as sunk low in a row sized for the bigger active one */
    align-items: center;
    height: var(--tabs-height);
    border-bottom: 1px solid var(--line);
    position: sticky;
    /* the gap between the bar's resting bottom edge and the bottom of
       the screen; dvh tracks the phone's toolbars as they show/hide,
       vh is the fallback for browsers without it */
    bottom: calc(100vh - var(--header-height) - var(--tabs-height));
    bottom: calc(100dvh - var(--header-height) - var(--tabs-height));
    /* Under the header (50) and every popup (newsletter 90, cart 100+),
       above the grid, with a solid background so nothing from the grid
       draws over the labels or blocks clicks on them. */
    z-index: 49;
    background: var(--bg);
  }

  /* Both pinned to row 1 explicitly: their column spans overlap (both
     include column 2), and grid auto-placement would otherwise bump the
     second one down into a new row. */
  #shop-tab-journals {
    grid-row: 1;
    grid-column: 1 / 3;
    justify-self: center;
  }

  #shop-tab-other {
    grid-row: 1;
    grid-column: 2 / 4;
    justify-self: center;
  }

  /* Same voice as the price on every card (JournalCard.astro) — this bar
     reads as "part of the same shop," not a separate piece of UI bolted
     on top of it. */
  .shop-tabs__tab {
    background: none;
    border: none;
    margin: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    /* A notch under the price size (JournalCard.astro), so the bar reads
       as a quiet label row rather than competing with the cards. The
       active state grows from here with a scale, not a bigger
       font-size. */
    font-size: clamp(0.72rem, 0.85vw, 1.1rem);
    line-height: 1;
    /* Georgia only has regular and bold, so font-weight can't animate —
       it jumps. The bold here is the regular letters thickened by two
       tight same-color shadows nudged left and right, which slide out
       smoothly (a text-stroke would be simpler, but browsers don't
       animate its width, so it snaps too). One layer of text the whole
       way through, no second copy fading in on top. The size bump is a
       transform scale, which animates smoothly and never reflows. */
    text-shadow:
      0 0 0 currentColor,
      0 0 0 currentColor;
    transform: scale(1);
    transition:
      transform 0.4s var(--ease),
      text-shadow 0.4s var(--ease);
  }

  .shop-tabs__tab.is-active {
    text-shadow:
      0.028em 0 0 currentColor,
      -0.028em 0 0 currentColor;
    transform: scale(1.2);
  }

  /* Hovering the inactive tab previews what clicking it would do — same
     bold/bigger treatment as .is-active. The active tab doesn't need
     this (it's already there), and touch devices have no hover state to
     misfire this on. */
  @media (hover: hover) {
    .shop-tabs__tab:not(.is-active):hover {
      text-shadow:
        0.028em 0 0 currentColor,
        -0.028em 0 0 currentColor;
      transform: scale(1.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-tabs__tab {
      transition: none;
    }
  }

  /* Below 720px the product grid drops to 2 columns (Grid.astro), so the
     bar does too: two equal halves, each label centered over its own
     column of journals below — same idea as desktop (labels tied to the
     grid's own columns), just with the 2-up grid's geometry. */
  @media (max-width: 720px) {
    .shop-tabs__bar {
      grid-template-columns: 1fr 1fr;
    }

    .shop-tabs__tab {
      font-size: 0.8rem;
    }

    #shop-tab-journals {
      grid-column: 1;
    }

    #shop-tab-other {
      grid-column: 2;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.shop-tabs__tab');
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach((other) => {
          const active = other.dataset.tab === target;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-selected', String(active));
        });
        document.getElementById('shop-panel-journals')?.toggleAttribute('hidden', target !== 'journals');
        document.getElementById('shop-panel-other')?.toggleAttribute('hidden', target !== 'other');
      });
    });
  });
</script>
