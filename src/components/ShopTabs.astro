---
// The shop page's tab bar: "journals" (the real product grid) vs "other
// cool stuff" (placeholder non-journal items — see OtherGrid.astro).
//
// Always starts on "journals", every time — server-rendered that way, not
// remembered across visits, so there's no localStorage/JS needed to land
// on the right tab. Landing on "/" is itself a fresh server render (and a
// ClientRouter navigation here swaps in a fresh one too, it isn't
// transition:persist), so this default just falls out of the markup below
// without any extra logic.
import Grid from './Grid.astro';
import OtherGrid from './OtherGrid.astro';
---

<div class="shop-tabs">
  <div class="shop-tabs__bar" role="tablist">
    <button
      type="button"
      class="shop-tabs__tab is-active"
      id="shop-tab-journals"
      role="tab"
      aria-selected="true"
      aria-controls="shop-panel-journals"
      data-tab="journals"
    >
      <span class="shop-tabs__label">journals</span>
      <span class="shop-tabs__label shop-tabs__label--bold" aria-hidden="true">journals</span>
    </button>
    <button
      type="button"
      class="shop-tabs__tab"
      id="shop-tab-other"
      role="tab"
      aria-selected="false"
      aria-controls="shop-panel-other"
      data-tab="other"
    >
      <span class="shop-tabs__label">other cool stuff</span>
      <span class="shop-tabs__label shop-tabs__label--bold" aria-hidden="true">other cool stuff</span>
    </button>
  </div>

  <div id="shop-panel-journals" role="tabpanel" aria-labelledby="shop-tab-journals">
    <Grid />
  </div>
  <div id="shop-panel-other" role="tabpanel" aria-labelledby="shop-tab-other" hidden>
    <OtherGrid />
  </div>
</div>

<style>
  /* Matches the product grid's own 3-column math exactly (same
     full-bleed repeat(3, 1fr), no outer gutter — see Grid.astro) so the
     two tab labels land precisely on top of the grid's two vertical
     divider lines below, the way Vanisha's own reference mockup placed
     them — not just left-aligned with a gap between them. Spanning two
     adjacent columns and centering within that span puts the label
     exactly on the shared boundary: centered across columns 1-2 lands on
     the first divider, centered across columns 2-3 lands on the second. */
  .shop-tabs__bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* center, not baseline — baseline aligned the two labels by their
       text line instead of their visual middle, so the smaller inactive
       label read as sunk low in a row sized for the bigger active one */
    align-items: center;
    padding: 1rem 0;
    /* Pinned to the height the bar had with the old, bigger labels, so
       shrinking the text didn't shrink the bar with it. */
    min-height: calc(2rem + clamp(1.25rem, 1.5vw, 1.65rem) + 1px);
    border-bottom: 1px solid var(--line);
    /* Grid.astro stretches its box 300px upward (padding-top/negative
       margin) so its vertical lines reach behind the fixed header. That
       stretched box now lands on top of this bar: its lines ran through
       the labels and it swallowed every click. Sitting above it with a
       solid background hides those lines here and keeps the tabs
       clickable. */
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  /* Both pinned to row 1 explicitly: their column spans overlap (both
     include column 2), and grid auto-placement would otherwise bump the
     second one down into a new row. */
  #shop-tab-journals {
    grid-row: 1;
    grid-column: 1 / 3;
    justify-self: center;
  }

  #shop-tab-other {
    grid-row: 1;
    grid-column: 2 / 4;
    justify-self: center;
  }

  /* Same voice as the price on every card (JournalCard.astro) — this bar
     reads as "part of the same shop," not a separate piece of UI bolted
     on top of it. */
  .shop-tabs__tab {
    display: grid;
    background: none;
    border: none;
    margin: 0;
    padding: 0;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    /* The price's own size (JournalCard.astro); the active state grows
       from here with a scale, not a bigger font-size. */
    font-size: clamp(0.85rem, 1.05vw, 1.4rem);
    line-height: 1;
    transform: scale(1);
    transition: transform 0.45s var(--ease);
  }

  /* Georgia has no in-between weights, so font-weight can't animate: it
     snaps straight from regular to bold. Instead each label is drawn
     twice in the same grid cell (regular + bold) and the two crossfade,
     while the size change is a transform scale rather than font-size,
     which animates smoothly and never reflows the text around it. */
  .shop-tabs__label {
    grid-area: 1 / 1;
    justify-self: center;
    transition: opacity 0.45s var(--ease);
  }

  .shop-tabs__label--bold {
    font-weight: 700;
    opacity: 0;
  }

  .shop-tabs__tab.is-active {
    transform: scale(1.2);
  }

  .shop-tabs__tab.is-active .shop-tabs__label {
    opacity: 0;
  }

  .shop-tabs__tab.is-active .shop-tabs__label--bold {
    opacity: 1;
  }

  /* Hovering the inactive tab previews what clicking it would do — same
     bold/bigger treatment as .is-active. The active tab doesn't need
     this (it's already there), and touch devices have no hover state to
     misfire this on. */
  @media (hover: hover) {
    .shop-tabs__tab:not(.is-active):hover {
      transform: scale(1.2);
    }

    .shop-tabs__tab:not(.is-active):hover .shop-tabs__label {
      opacity: 0;
    }

    .shop-tabs__tab:not(.is-active):hover .shop-tabs__label--bold {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-tabs__tab,
    .shop-tabs__label {
      transition: none;
    }
  }

  /* Below 720px the product grid itself drops to 2 columns (Grid.astro),
     so there's no longer a clean "two dividers" to center these on — a
     plain left-aligned row (matching the rest of the site's mobile
     gutter) reads better than forcing a 3-column anchor onto a 2-column
     grid. */
  @media (max-width: 720px) {
    .shop-tabs__bar {
      display: flex;
      gap: clamp(1.25rem, 8vw, 2.5rem);
      padding: 1.1rem var(--gutter) 0.85rem;
    }

    #shop-tab-journals,
    #shop-tab-other {
      grid-column: auto;
      justify-self: auto;
      /* left-aligned here, so grow from the left edge instead of the
         middle, or the scale would push it into the side gutter */
      transform-origin: left center;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.shop-tabs__tab');
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.tab;
        tabs.forEach((other) => {
          const active = other.dataset.tab === target;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-selected', String(active));
        });
        document.getElementById('shop-panel-journals')?.toggleAttribute('hidden', target !== 'journals');
        document.getElementById('shop-panel-other')?.toggleAttribute('hidden', target !== 'other');
      });
    });
  });
</script>
