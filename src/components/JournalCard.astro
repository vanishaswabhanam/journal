---
// Renders ONE journal entry. This is the only place journal-card styling
// lives — every journal in the grid goes through this same template, so
// they always look consistent no matter how many you add.
//
// Layout (measured from the original design): price pinned top-left, the
// product photo in a fixed 3:4 box centered in the cell. The box has the
// same size for every journal, so differently-shaped photos still line up.
import type { CollectionEntry } from 'astro:content';
import { journalHref } from '../lib/journals';

interface Props {
  entry: Extract<CollectionEntry<'grid'>['data'], { type: 'journal' }>;
}

const { entry } = Astro.props;
const href = journalHref(entry);
---

<a
  href={href}
  class="journal-card"
  class:list={{ 'journal-card--sold': entry.sold }}
  aria-label={`View ${entry.name}`}
>
  {entry.sold ? (
    <span class="journal-card__price journal-card__sold-badge">Sold</span>
  ) : (
    <p class="journal-card__price">${entry.price}</p>
  )}
  <div class="journal-card__image-wrap">
    <img
      src={entry.image}
      alt={entry.alt ?? entry.name}
      class="journal-card__image"
      class:list={{ 'journal-card__image--nudge-up': entry.name === 'The Oxblood' }}
      loading="lazy"
      transition:name={`product-image:${href}`}
    />
  </div>
</a>

<style>
  .journal-card {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .journal-card__image {
    transition: transform 0.5s var(--ease);
  }

  @media (hover: hover) {
    .journal-card:hover .journal-card__image {
      transform: scale(1.045);
    }
  }

  /* The Oxblood's source photo exactly fills the card's 3:4 box (no
     letterboxing for object-position to shift), so nudging the subject
     up needs a slight zoom — cropping a sliver off the bottom — rather
     than just repositioning. The hover rule below composes this same
     zoom with the regular hover-zoom amount, rather than the hover
     state replacing it (it would, if this were plain inline styling —
     a class/stylesheet rule can combine with :hover instead). */
  .journal-card__image--nudge-up {
    transform: scale(1.08) translateY(-4%);
  }

  @media (hover: hover) {
    .journal-card:hover .journal-card__image--nudge-up {
      transform: scale(1.129) translateY(-4%);
    }
  }

  .journal-card__price {
    position: absolute;
    top: 5.4%;
    left: 4.3%;
    margin: 0;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(0.85rem, 1.05vw, 1.4rem);
    line-height: 1;
  }

  .journal-card__image-wrap {
    position: absolute;
    top: 48.6%;
    left: 50%;
    height: 63%;
    aspect-ratio: 3 / 4;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .journal-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Sits in the price's own spot (inherits position/top/left from
     .journal-card__price) instead of its own corner — replaces the
     price entirely for a sold journal, not shown alongside it. Solid
     ink fill, not just an outline, so it reads as clearly as the price
     does. */
  .journal-card__sold-badge {
    padding: 0.3em 0.9em;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: clamp(0.78rem, 0.95vw, 1.2rem);
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .journal-card__price {
      font-size: 0.95rem;
    }

    .journal-card__image-wrap {
      top: 52%;
      height: 74%;
    }
  }
</style>
