---
// Renders ONE journal entry. This is the only place journal-card styling
// lives — every journal in the grid goes through this same template, so
// they always look consistent no matter how many you add.
//
// Layout (measured from the original design): price pinned top-left, the
// product photo in a fixed 3:4 box centered in the cell. The box has the
// same size for every journal, so differently-shaped photos still line up.
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: Extract<CollectionEntry<'grid'>['data'], { type: 'journal' }>;
}

const { entry } = Astro.props;
---

<article class="journal-card" class:list={{ 'journal-card--sold': entry.sold }}>
  <p class="journal-card__price">${entry.price}</p>
  <div class="journal-card__image-wrap">
    <img
      src={entry.image}
      alt={entry.alt ?? entry.name}
      class="journal-card__image"
      loading="lazy"
    />
    {entry.sold && <span class="journal-card__sold-badge">Sold out</span>}
  </div>
</article>

<style>
  .journal-card {
    position: absolute;
    inset: 0;
  }

  .journal-card__price {
    position: absolute;
    top: 5.4%;
    left: 4.3%;
    margin: 0;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: clamp(0.85rem, 1.05vw, 1.4rem);
    line-height: 1;
  }

  .journal-card__image-wrap {
    position: absolute;
    top: 48.6%;
    left: 50%;
    height: 63%;
    aspect-ratio: 3 / 4;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .journal-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .journal-card--sold .journal-card__image {
    opacity: 0.35;
  }

  .journal-card__sold-badge {
    position: absolute;
    font-family: Georgia, 'Times New Roman', Times, serif;
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  @media (max-width: 720px) {
    .journal-card__price {
      font-size: 0.95rem;
    }

    .journal-card__image-wrap {
      top: 52%;
      height: 74%;
    }
  }
</style>
