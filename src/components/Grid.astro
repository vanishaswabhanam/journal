---
// The 3-column grid. Fetches every entry from src/content/grid/, sorts by
// `order`, and renders each one as the right card type. This file has no
// per-item knowledge — add, remove, reorder, or retype entries in
// src/content/grid/ and this component just reflects it. See CONTENT.md.
import { getCollection } from 'astro:content';
import JournalCard from './JournalCard.astro';
import PromoCard from './PromoCard.astro';

// Sold journals always sink to the back of the grid — within the
// unsold group and the sold group, `order` still applies. Promo cards
// have no `sold` field (only the journal entry type does), so they're
// treated as unsold and keep sorting by `order` among the in-stock
// journals, same as before.
const isSold = (entry: Awaited<ReturnType<typeof getCollection<'grid'>>>[number]) =>
  entry.data.type === 'journal' && entry.data.sold;

// Pouches live in the same folder but on the "other cool stuff" tab
// (OtherGrid.astro), so they're left out here.
const entries = (await getCollection('grid', (e) => e.data.type !== 'journal' || e.data.category === 'journal')).sort((a, b) => {
  const aSold = isSold(a);
  const bSold = isSold(b);
  if (aSold !== bSold) return aSold ? 1 : -1;
  return a.data.order - b.data.order;
});
---

<div class="grid">
  {entries.map((entry) => (
    <div class="grid__cell">
      {entry.data.type === 'journal' ? (
        <JournalCard entry={entry.data} />
      ) : (
        <PromoCard entry={entry.data} />
      )}
    </div>
  ))}
</div>

<style>
  /* The one horizontal line at the top is the shop tab bar's own
     border-bottom (ShopTabs.astro), right above this grid. The grid
     doesn't draw its own top border too: two separate 1px lines that
     close together never land on exactly the same device pixel, so it
     read as one thicker, slightly-doubled line instead of one crisp one.

     The vertical lines are drawn as a background instead of per-cell
     borders, and stretched 300px upward (padding-top pushes the
     background's drawable area up; the matching negative margin pulls
     the box back down so content still starts in the same place). When
     the page bounces past the top, the tab bar holds still while this
     grid drops, opening a gap between them; the stretched lines fill
     that gap so they stay joined to the bar instead of floating loose.
     The rest of the stretch sits behind the bar and header, which both
     have solid backgrounds and stack above this grid, so the lines never
     show through or above the bar. border-right on each cell couldn't do
     this — a cell's border only exists for that cell's own box. */
  .grid {
    --cols: 3;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    padding-top: 300px;
    margin-top: -300px;
    /* A last row that doesn't fill every column (an odd card count) only
       gets a border-bottom under whichever cells actually exist there —
       the empty columns next to it have no cell element at all, so the
       row reads as cut off instead of closed. This sits at the grid's
       own content-box bottom edge, which for CSS Grid *is* the last
       row's bottom edge (not a separately-positioned element like the
       header, where two close-but-distinct borders can read as
       doubled) — so a fully-populated last row just gets the same line
       from both its cell and the grid, in the same place. */
    border-bottom: 1px solid var(--line);
    background-repeat: no-repeat;
    background-size: 1px 100%;
    background-image: linear-gradient(var(--line), var(--line)), linear-gradient(var(--line), var(--line)), linear-gradient(var(--line), var(--line)),
      linear-gradient(var(--line), var(--line));
    background-position:
      0 0,
      calc(100% / var(--cols)) 0,
      calc(200% / var(--cols)) 0,
      100% 0;
  }

  /* Every cell — journal or promo — is the same fixed shape (668:570,
     measured from the original design), so cards can be swapped or moved
     freely without the layout shifting. */
  .grid__cell {
    position: relative;
    aspect-ratio: 668 / 570;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 720px) {
    .grid {
      --cols: 2;
    }

    .grid__cell {
      aspect-ratio: 1 / 1;
    }
  }
</style>
