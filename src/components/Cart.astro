---
// The whole cart system: the header toggle button, the slide-over drawer,
// and the "request summary" — a receipt-styled popup that ends in the
// actual payment step, not just an inquiry.
//
// Every journal here is one of one — there's no "quantity". A cart item is
// just present or not; clicking "Add to cart" on something already in the
// cart does nothing (see addToCart below), and the button itself shows
// "In your cart" instead of inviting a second click — see syncAddButtons.
//
// There's no real payment processor here — this is still not a checkout.
// "Proceed to buy" opens the receipt, which asks for name + shipping
// address + email (needed to actually ship these — see the shipping-form
// panel), emails that straight to {site.name} via Web3Forms
// (src/lib/web3forms.ts) with the visitor's email set as reply-to, then
// reveals a "Pay with Venmo" step for the cart's total (src/lib/venmo.ts —
// see CONTENT.md for why this is a deep link, not a real integration).
// The cart only clears once the visitor confirms they've actually sent
// that payment — there's no way for this site to know a Venmo payment
// landed on its own.
//
// Rendered inside SiteHeader.astro on every page — the header is NOT
// transition:persist (it used to be; removing it fixed a worse bug, see
// SiteHeader.astro), so this whole thing is torn down and rebuilt fresh
// on every navigation. Cart *contents* still survive that via
// localStorage, not in-memory state — see wireCartControls' comment near
// the bottom for how its listeners stay attached across that rebuilding.
// Any button anywhere on the site can add to the cart — see CONTENT.md's
// "The cart" section — by
// rendering `data-add-to-cart='{"slug":"...","name":"...","price":65,"image":"..."}'`
// on a <button>; this component listens for clicks on that attribute
// globally, so nothing else needs to be wired up per-page.
import { site } from '../site.config';

// Shipping is US-only (see the contact page's FAQ), so the state field is
// a real dropdown of actual US states/territories rather than free text —
// no typos, no "CAlifornia", nothing to mistype. A proper address
// autocomplete (type-ahead against a real address database, like Google
// Places) is a separate, paid service with its own account/API key to
// set up — this is the zero-cost, no-new-accounts version of "make the
// address real."
const usStates = [
  ['AL', 'Alabama'], ['AK', 'Alaska'], ['AZ', 'Arizona'], ['AR', 'Arkansas'], ['CA', 'California'],
  ['CO', 'Colorado'], ['CT', 'Connecticut'], ['DE', 'Delaware'], ['DC', 'District of Columbia'],
  ['FL', 'Florida'], ['GA', 'Georgia'], ['HI', 'Hawaii'], ['ID', 'Idaho'], ['IL', 'Illinois'],
  ['IN', 'Indiana'], ['IA', 'Iowa'], ['KS', 'Kansas'], ['KY', 'Kentucky'], ['LA', 'Louisiana'],
  ['ME', 'Maine'], ['MD', 'Maryland'], ['MA', 'Massachusetts'], ['MI', 'Michigan'], ['MN', 'Minnesota'],
  ['MS', 'Mississippi'], ['MO', 'Missouri'], ['MT', 'Montana'], ['NE', 'Nebraska'], ['NV', 'Nevada'],
  ['NH', 'New Hampshire'], ['NJ', 'New Jersey'], ['NM', 'New Mexico'], ['NY', 'New York'],
  ['NC', 'North Carolina'], ['ND', 'North Dakota'], ['OH', 'Ohio'], ['OK', 'Oklahoma'], ['OR', 'Oregon'],
  ['PA', 'Pennsylvania'], ['RI', 'Rhode Island'], ['SC', 'South Carolina'], ['SD', 'South Dakota'],
  ['TN', 'Tennessee'], ['TX', 'Texas'], ['UT', 'Utah'], ['VT', 'Vermont'], ['VA', 'Virginia'],
  ['WA', 'Washington'], ['WV', 'West Virginia'], ['WI', 'Wisconsin'], ['WY', 'Wyoming'],
  ['PR', 'Puerto Rico'], ['GU', 'Guam'], ['VI', 'U.S. Virgin Islands'],
];
---

<button type="button" id="cart-toggle" class="cart-toggle" aria-label="Open cart">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M6 8h12l-1 12.5a1 1 0 0 1-1 .9H8a1 1 0 0 1-1-.9L6 8Z" stroke-linejoin="round" />
    <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke-linecap="round" />
  </svg>
  <span id="cart-count" class="cart-toggle__count" hidden>0</span>
</button>

<div id="cart-scrim" class="cart-scrim" hidden></div>

<aside id="cart-drawer" class="cart-drawer" hidden aria-label="Shopping cart">
  <div class="paper">
    <div class="paper__head">
      <div>
        <img src="/images/nav/hide-st-logo.png" alt={site.name} class="paper__brand" />
        <p class="paper__tag">Handmade &middot; one of one</p>
      </div>
      <button type="button" id="cart-close" class="paper__close" aria-label="Close cart">&times;</button>
    </div>

    <div class="paper__perf" aria-hidden="true"></div>

    <div id="cart-items" class="paper__items"></div>

    <div class="paper__perf" aria-hidden="true"></div>

    <div class="paper__foot">
      <div class="line line--total">
        <span class="line__label">Subtotal</span>
        <span class="line__leader" aria-hidden="true"></span>
        <span id="cart-subtotal" class="line__value mono">$0</span>
      </div>
      <button type="button" id="cart-request" class="paper__cta" disabled>Proceed to buy</button>
      <p class="paper__hint">The next step collects shipping details, then Venmo.</p>
    </div>
  </div>
</aside>

<div id="receipt-scrim" class="cart-scrim" hidden></div>
<div id="receipt" class="receipt" hidden role="dialog" aria-modal="true" aria-label="Request summary">
  <div class="paper paper--card">
    <button type="button" id="receipt-close" class="paper__close" aria-label="Close">&times;</button>
    <div class="paper__head paper__head--stack">
      <img src="/images/nav/hide-st-logo.png" alt={site.name} class="paper__brand" />
      <p class="paper__tag">Handmade &middot; one of one</p>
    </div>

    <div class="paper__perf" aria-hidden="true"></div>

    <div class="receipt__ref">
      <span>Order no.</span>
      <span id="receipt-ref" class="mono"></span>
    </div>

    <div id="receipt-items" class="paper__items paper__items--static"></div>

    <div class="line line--total">
      <span class="line__label">Total</span>
      <span class="line__leader" aria-hidden="true"></span>
      <span id="receipt-total" class="line__value mono"></span>
    </div>

    <div class="paper__perf" aria-hidden="true"></div>

    <div id="receipt-send-panel">
      <p class="paper__note">
        I'll need a little info to actually ship these to you. Fill this in, then pay via Venmo
        to complete the order.
      </p>
      <div class="receipt__field">
        <label for="receipt-name">Your name</label>
        <input id="receipt-name" type="text" required autocomplete="name" />
      </div>
      <div class="receipt__field">
        <label for="receipt-street">Street address</label>
        <input id="receipt-street" type="text" required autocomplete="address-line1" placeholder="123 Main St" />
      </div>
      <div class="receipt__field-row">
        <div class="receipt__field receipt__field--city">
          <label for="receipt-city">City</label>
          <input id="receipt-city" type="text" required autocomplete="address-level2" />
        </div>
        <div class="receipt__field receipt__field--state">
          <label for="receipt-state">State</label>
          <select id="receipt-state" required autocomplete="address-level1">
            <option value="" disabled selected></option>
            {usStates.map(([abbr, name]) => <option value={abbr}>{name}</option>)}
          </select>
        </div>
        <div class="receipt__field receipt__field--zip">
          <label for="receipt-zip">ZIP</label>
          <input
            id="receipt-zip"
            type="text"
            inputmode="numeric"
            required
            autocomplete="postal-code"
            pattern="[0-9]{5}(-[0-9]{4})?"
            title="5-digit ZIP code"
            placeholder="94103"
          />
        </div>
      </div>
      <div class="receipt__field">
        <label for="receipt-email">Your email</label>
        <input id="receipt-email" type="email" required placeholder="you@email.com" autocomplete="email" />
      </div>
      <button type="button" id="receipt-continue" class="paper__cta">Continue to Venmo</button>
    </div>

    <div id="receipt-venmo" class="receipt__venmo" hidden>
      {/* Touch devices (phones/tablets) only — see CONTENT.md's "Direct
          Venmo payment" for why this is split by platform. Color swaps
          with #receipt-done once this is actually pressed, see the style
          block below — it's the primary action until then. */}
      <a id="receipt-venmo-btn" class="receipt__venmo-btn receipt__venmo-btn--touch" href="#"></a>
      <p class="receipt__venmo-hint receipt__venmo-hint--touch">Opens the Venmo app, pre-filled.</p>

      {/* Mouse/trackpad devices only — Venmo has no desktop app or web
          checkout, so there's nothing for a button to open here. */}
      <p class="receipt__venmo-label receipt__venmo-label--desktop">Pay via Venmo</p>
      <p id="receipt-venmo-desktop-hint" class="receipt__venmo-hint receipt__venmo-hint--desktop"></p>

      <button type="button" id="receipt-done" class="paper__cta receipt__venmo-done">I've sent the payment</button>
      <button type="button" id="receipt-back-to-form" class="receipt__back">&larr; Back</button>
    </div>

    {/* Nothing is actually sent yet at this point — the order (shipping
        details plus the payment claim below) only goes out once this is
        confirmed, not the moment "I've sent the payment" is first
        clicked, in case that was a misclick. */}
    <div id="receipt-confirm" class="receipt__confirm" hidden>
      <p class="paper__note">Are you suuuuurreeee you actually sent the payment?</p>
      <button type="button" id="receipt-confirm-yes" class="paper__cta">Yes, I really have</button>
      <button type="button" id="receipt-confirm-back" class="receipt__confirm-back">Not yet, go back</button>
      <p id="receipt-error" class="receipt__error" role="status" aria-live="polite" hidden></p>
    </div>

    <div id="receipt-success" class="receipt__success" role="status" aria-live="polite" hidden>
      <p class="receipt__success-heading">Thanks!</p>
      <p class="receipt__success-body">
        I'll check for your payment and get this shipped out once it's confirmed, tracking number
        included. Reference: <span id="receipt-success-ref" class="mono"></span>.
      </p>
    </div>
  </div>
</div>

<script>
  import { submitToWeb3Forms } from '../lib/web3forms';
  import { venmoPayLink } from '../lib/venmo';
  import { site } from '../site.config';

  const STORAGE_KEY = 'journal-cart:v1';
  // Set by openReceipt(), read by sendRequest() — the one request currently
  // on screen, so the send button doesn't need to recompute/re-read it.
  let pendingRequest = null;
  // The 5-second delay before the pressed-state color swap — tracked so
  // it can be cancelled if the visitor backs out before it fires (see
  // openReceipt() and goBackToForm()), otherwise a stale timer could add
  // the pressed class back after they've already left or reset that step.
  let venmoPressTimer = null;

  const read = () => {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
    } catch {
      return [];
    }
  };
  const write = (items) => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    } catch {
      // Storage can be unavailable (private browsing, quota) — the cart
      // just won't persist across reloads in that case, which is fine.
    }
    render();
  };
  const subtotalOf = (items) => items.reduce((sum, i) => sum + i.price, 0);
  const money = (n) => `$${n.toFixed(2).replace(/\.00$/, '')}`;
  const escapeHtml = (s) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

  function addToCart(item) {
    const items = read();
    if (items.some((i) => i.slug === item.slug)) {
      // Already have this one — there's only one of it. Just show them
      // what's in the cart rather than pretending to add a second.
      openDrawer();
      return;
    }
    items.push({ slug: item.slug, name: item.name, price: item.price, image: item.image });
    write(items);
    openDrawer();
  }

  function removeFromCart(slug) {
    write(read().filter((i) => i.slug !== slug));
  }

  function itemRow(i, { removable }) {
    return `
      <div class="paper__item">
        <img src="${i.image}" alt="" class="paper__thumb" />
        <div class="line">
          <span class="line__label">${escapeHtml(i.name)}</span>
          <span class="line__leader" aria-hidden="true"></span>
          <span class="line__value mono">${money(i.price)}</span>
        </div>
        ${removable ? `<button type="button" class="paper__remove" data-remove="${i.slug}" aria-label="Remove ${escapeHtml(i.name)}">&times;</button>` : ''}
      </div>`;
  }

  // Every "Add to cart" button anywhere on the site reflects whether its
  // journal is already in the cart — since each one is one of one, that's
  // the difference between "add" and "you already have this."
  function syncAddButtons() {
    const slugs = new Set(read().map((i) => i.slug));
    document.querySelectorAll('[data-add-to-cart]').forEach((btn) => {
      let data;
      try {
        data = JSON.parse(btn.getAttribute('data-add-to-cart'));
      } catch {
        return;
      }
      if (!btn.dataset.defaultLabel) btn.dataset.defaultLabel = btn.innerHTML;
      const inCart = slugs.has(data.slug);
      btn.classList.toggle('is-in-cart', inCart);
      btn.disabled = inCart;
      btn.innerHTML = inCart
        ? '<span>In your cart</span>'
        : btn.dataset.defaultLabel;
    });
  }

  function render() {
    const items = read();
    const countEl = document.getElementById('cart-count');
    const itemsEl = document.getElementById('cart-items');
    const subtotalEl = document.getElementById('cart-subtotal');
    const requestBtn = document.getElementById('cart-request');
    if (countEl && itemsEl && subtotalEl && requestBtn) {
      countEl.textContent = String(items.length);
      countEl.hidden = items.length === 0;

      itemsEl.innerHTML =
        items.length === 0
          ? '<p class="paper__empty">Your cart is empty.</p>'
          : items.map((i) => itemRow(i, { removable: true })).join('');

      subtotalEl.textContent = money(subtotalOf(items));
      requestBtn.disabled = items.length === 0;
    }
    syncAddButtons();
  }

  // Event delegation: works for the remove buttons re-rendered above, any
  // "Add to cart" button on any page, and survives client-side navigation
  // without re-binding anything.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const addBtn = target.closest('[data-add-to-cart]');
    if (addBtn) {
      try {
        addToCart(JSON.parse(addBtn.getAttribute('data-add-to-cart')));
      } catch {
        /* malformed data-add-to-cart — ignore rather than break the page */
      }
      return;
    }
    const removeBtn = target.closest('[data-remove]');
    if (removeBtn) {
      removeFromCart(removeBtn.getAttribute('data-remove'));
    }
  });

  function openDrawer() {
    const drawer = document.getElementById('cart-drawer');
    const scrim = document.getElementById('cart-scrim');
    if (!drawer || !scrim) return;
    drawer.hidden = false;
    scrim.hidden = false;
    requestAnimationFrame(() => drawer.classList.add('cart-drawer--open'));
    setThemeColor('paper');
  }
  function closeDrawer() {
    const drawer = document.getElementById('cart-drawer');
    const scrim = document.getElementById('cart-scrim');
    if (!drawer || !scrim) return;
    drawer.classList.remove('cart-drawer--open');
    setThemeColor('bg');
    window.setTimeout(() => {
      drawer.hidden = true;
      scrim.hidden = true;
    }, 250);
  }

  // Mobile Safari tints its status bar / toolbar to the page's theme-color
  // meta tag — flipping it to match whichever popup is open (both the
  // drawer and the receipt sit on the same white --paper) makes the
  // phone's own chrome feel like part of the popup instead of a mismatched
  // gray strip above/below it. See the meta tag in BaseLayout.astro.
  function setThemeColor(token) {
    const meta = document.querySelector('meta[name="theme-color"]');
    if (!meta) return;
    const varName = token === 'paper' ? '--paper' : '--bg';
    const value = getComputedStyle(document.documentElement).getPropertyValue(varName).trim();
    if (value) meta.setAttribute('content', value);
  }

  function openReceipt() {
    const items = read();
    if (items.length === 0) return;
    const ref = `ORD-${Date.now().toString(36).toUpperCase()}`;
    const sub = subtotalOf(items);
    pendingRequest = { items, ref, sub };

    document.getElementById('receipt-ref').textContent = ref;
    document.getElementById('receipt-items').innerHTML = items.map((i) => itemRow(i, { removable: false })).join('');
    document.getElementById('receipt-total').textContent = money(sub);

    // Reset back to the very first step every time the receipt opens, in
    // case it's showing last time's venmo/confirm/success/error state from
    // a previous visit.
    document.getElementById('receipt-send-panel').hidden = false;
    document.getElementById('receipt-venmo').hidden = true;
    document.getElementById('receipt-confirm').hidden = true;
    document.getElementById('receipt-success').hidden = true;
    document.getElementById('receipt-error').hidden = true;
    clearTimeout(venmoPressTimer);
    document.getElementById('receipt-venmo').classList.remove('is-venmo-pressed');
    document.getElementById('receipt-name').value = '';
    document.getElementById('receipt-street').value = '';
    document.getElementById('receipt-city').value = '';
    document.getElementById('receipt-state').value = '';
    document.getElementById('receipt-zip').value = '';
    document.getElementById('receipt-email').value = '';

    closeDrawer();
    document.getElementById('receipt-scrim').hidden = false;
    document.getElementById('receipt').hidden = false;
    setThemeColor('paper');
  }
  function closeReceipt() {
    document.getElementById('receipt-scrim').hidden = true;
    document.getElementById('receipt').hidden = true;
    setThemeColor('bg');
  }

  // Step 1 of 3: just validates what's needed to ship these — name,
  // address, email — and moves on to the Venmo step. Nothing is sent
  // anywhere yet; see markPaid() below for why that's deliberately
  // delayed all the way to the final confirmation instead of firing here.
  function continueToVenmo() {
    if (!pendingRequest) return;
    const nameInput = document.getElementById('receipt-name');
    const streetInput = document.getElementById('receipt-street');
    const cityInput = document.getElementById('receipt-city');
    const stateInput = document.getElementById('receipt-state');
    const zipInput = document.getElementById('receipt-zip');
    const emailInput = document.getElementById('receipt-email');
    if (!nameInput.reportValidity()) return;
    if (!streetInput.reportValidity()) return;
    if (!cityInput.reportValidity()) return;
    if (!stateInput.reportValidity()) return;
    if (!zipInput.reportValidity()) return;
    if (!emailInput.reportValidity()) return;

    const { sub, items, ref } = pendingRequest;
    document.getElementById('receipt-send-panel').hidden = true;
    showVenmoStep(sub, items, ref);
  }

  // Back to the shipping form from the Venmo step — the fields keep
  // whatever was already typed, nothing is cleared, and the pay-button
  // press state resets since this counts as starting that part over.
  function goBackToForm() {
    document.getElementById('receipt-venmo').hidden = true;
    clearTimeout(venmoPressTimer);
    document.getElementById('receipt-venmo').classList.remove('is-venmo-pressed');
    document.getElementById('receipt-send-panel').hidden = false;
  }

  // Step 2 of 3: the same clean, platform-split Venmo option used
  // elsewhere on this site — a one-tap link on a touch device, plain
  // instructions on desktop (Venmo has no desktop app or web checkout to
  // open) — now for the cart's total instead of a single journal's price.
  function showVenmoStep(sub, items, ref) {
    if (!site.venmo?.username) return;
    const note = `${items.map((i) => i.name).join(', ')} (${ref})`.slice(0, 250);
    const link = venmoPayLink(site.venmo.username, sub, note);

    const touchBtn = document.getElementById('receipt-venmo-btn');
    touchBtn.href = link;
    touchBtn.textContent = `Pay with Venmo: ${money(sub)}`;

    document.getElementById('receipt-venmo-desktop-hint').innerHTML =
      `Send <strong>${money(sub)}</strong> to <strong>@${escapeHtml(site.venmo.username)}</strong> in the Venmo app, with the note "${escapeHtml(note)}".`;

    document.getElementById('receipt-venmo').hidden = false;
  }

  // "I've sent the payment" doesn't finalize anything by itself — it's
  // one tap away from the actual send, in case that was a misclick. The
  // real confirmation is the step after this one.
  function showConfirm() {
    document.getElementById('receipt-venmo').hidden = true;
    document.getElementById('receipt-confirm').hidden = false;
  }

  // Back to the Venmo step from the "are you sure" prompt — keeps the
  // pay-button press state as it was, this isn't restarting anything.
  function goBackToVenmo() {
    document.getElementById('receipt-confirm').hidden = true;
    document.getElementById('receipt-venmo').hidden = false;
  }

  // The actual, final step: only now does anything get sent anywhere —
  // one email with the full order (items, total, reference, shipping
  // address) AND the Venmo payment claim together, since there's no
  // point emailing shipping details for a checkout someone might abandon
  // before ever reaching this point.
  //
  // This click is still just a claim, not a verified fact — there's no
  // webhook or API that could tell this site a Venmo payment actually
  // landed, so someone could say they paid and never send anything. What
  // this does give: a timestamped record with a reference number, sent
  // right as the claim is made, to check Venmo against before shipping —
  // not proof, but not nothing either.
  async function markPaid() {
    if (!pendingRequest) return;
    const { items, ref, sub } = pendingRequest;
    const nameInput = document.getElementById('receipt-name');
    const streetInput = document.getElementById('receipt-street');
    const cityInput = document.getElementById('receipt-city');
    const stateInput = document.getElementById('receipt-state');
    const zipInput = document.getElementById('receipt-zip');
    const emailInput = document.getElementById('receipt-email');

    const yesBtn = document.getElementById('receipt-confirm-yes');
    const errorEl = document.getElementById('receipt-error');
    yesBtn.disabled = true;
    yesBtn.textContent = 'Sending…';
    errorEl.hidden = true;

    const lines = items.map((i) => `${i.name}: ${money(i.price)}`);
    lines.push(
      '',
      `Total: ${money(sub)}`,
      `Reference: ${ref}`,
      '',
      `Ship to: ${nameInput.value}`,
      streetInput.value,
      `${cityInput.value}, ${stateInput.value} ${zipInput.value}`,
      '',
      `You confirmed you've sent ${money(sub)} via Venmo for this order. I'll check for it and ship once it's confirmed.`,
    );
    // cc so the buyer also gets their own copy of this as a receipt, not
    // just whoever owns PUBLIC_WEB3FORMS_KEY — BUT Web3Forms only actually
    // sends that cc copy on a paid plan, it's a silent no-op on the free
    // one. Left in (harmless either way) for the day this account is on a
    // plan that supports it; see CONTENT.md for the real fix in the
    // meantime.
    const result = await submitToWeb3Forms({
      subject: `Order: ${items.map((i) => i.name).join(', ')}`,
      email: emailInput.value,
      cc: emailInput.value,
      message: `${lines.join('\n')}\n\nFrom the ${site.name} site cart.`,
    });

    yesBtn.disabled = false;
    yesBtn.textContent = 'Yes, I really have';

    if (result.ok) {
      document.getElementById('receipt-confirm').hidden = true;
      document.getElementById('receipt-success-ref').textContent = ref;
      document.getElementById('receipt-success').hidden = false;
      write([]);
    } else {
      errorEl.textContent = result.message;
      errorEl.hidden = false;
    }
  }

  // The header (and this Cart inside it) is NOT transition:persist — it's
  // destroyed and rebuilt fresh on every navigation, same as the rest of
  // the page. This whole <script> module, though, only ever executes
  // ONCE (on the very first real page load) — Astro doesn't re-run it on
  // a soft navigation. So every listener below has to be (re-)attached
  // from inside a function called on 'astro:page-load' too, or it's only
  // ever wired to the first page's copy of these elements; every element
  // after that first navigation is a stranger to all of this.
  function wireCartControls() {
    document.getElementById('cart-toggle')?.addEventListener('click', openDrawer);
    document.getElementById('cart-close')?.addEventListener('click', closeDrawer);
    document.getElementById('cart-scrim')?.addEventListener('click', closeDrawer);
    document.getElementById('cart-request')?.addEventListener('click', openReceipt);
    document.getElementById('receipt-continue')?.addEventListener('click', continueToVenmo);
    document.getElementById('receipt-back-to-form')?.addEventListener('click', goBackToForm);
    document.getElementById('receipt-done')?.addEventListener('click', showConfirm);
    document.getElementById('receipt-confirm-back')?.addEventListener('click', goBackToVenmo);
    document.getElementById('receipt-confirm-yes')?.addEventListener('click', markPaid);
    // Marks the Venmo link as pressed (see the style block for the
    // black/white swap this drives) — fires regardless of whether the
    // Venmo app actually opened, which is the most this page can ever know.
    // Delayed 5 seconds rather than instant: gives them a moment to
    // actually be in Venmo sending it before the page flips which button
    // looks like the next step.
    document.getElementById('receipt-venmo-btn')?.addEventListener('click', () => {
      clearTimeout(venmoPressTimer);
      venmoPressTimer = window.setTimeout(() => {
        document.getElementById('receipt-venmo').classList.add('is-venmo-pressed');
      }, 5000);
    });
    document.getElementById('receipt-close')?.addEventListener('click', closeReceipt);
    document.getElementById('receipt-scrim')?.addEventListener('click', closeReceipt);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeReceipt();
    closeDrawer();
  });

  // Re-wire the buttons above and re-sync "Add to cart"/cart contents
  // every time a new page's content shows up — see wireCartControls'
  // comment for why a fresh (re-)bind is needed on every navigation, not
  // just once.
  document.addEventListener('astro:page-load', () => {
    wireCartControls();
    syncAddButtons();
    render();
  });

  wireCartControls();
  render();
</script>

