---
// A hand-assembled "mood board" for the Journal page — process shots, a
// material flat-lay, and the shop's own stamp card scattered and pinned
// like an actual corkboard rather than laid out in a tidy grid. Every tile
// is draggable (see the script below) — picking one up and moving it is
// half the point of a mood board page.
//
// Images live in public/images/moodboard/ — see CONTENT.md if more get
// added later. Positions/rotations here are the *resting* layout; a
// visitor's own rearrangement lives only in their browser's localStorage
// (see the script), so everyone starts from this same scattered arrangement.
interface Dot {
  color: string;
  corner: 'tl' | 'tr' | 'bl' | 'br';
  size?: number;
  offset?: number;
}

interface Tile {
  id: string;
  src: string;
  alt: string;
  x: number;
  y: number;
  w: number;
  r: number;
  z: number;
  dots?: Dot[];
}

// x/y/w are px on the ~840x680 board (see .moodboard__board below); r is
// degrees of rotation. Deliberately not a grid — corners overlap slightly
// and rotations vary tile to tile, the way photos actually land on a
// corkboard, not how they'd land on a shop shelf.
const tiles: Tile[] = [
  {
    id: 'pattern-clips',
    src: '/images/moodboard/pattern-clips.webp',
    alt: 'A finished journal held open with binder clips next to its stitching pattern',
    x: 10,
    y: 10,
    w: 230,
    r: -6,
    z: 2,
    dots: [{ color: '#a66a3c', corner: 'tl' }],
  },
  {
    id: 'floral-sketch',
    src: '/images/moodboard/floral-sketch.webp',
    alt: 'A hand-painted floral illustration in cream on deep red',
    x: 288,
    y: 0,
    w: 226,
    r: 4,
    z: 3,
    dots: [{ color: '#5c7a6e', corner: 'tr' }],
  },
  {
    id: 'stamp-card',
    src: '/images/moodboard/stamp-card.webp',
    alt: 'A stamp-style card reading: Leather Journals, handmade with love and care, one of one, hand-stitched pockets, suede inserts, made by Vanisha',
    x: 568,
    y: 36,
    w: 230,
    r: -3,
    z: 2,
  },
  {
    id: 'leather-swatches',
    src: '/images/moodboard/leather-swatches.webp',
    alt: 'A flat lay of cut leather pieces in different colors and textures',
    x: 0,
    y: 322,
    w: 232,
    r: 5,
    z: 4,
    dots: [{ color: '#e7dcc3', corner: 'br' }],
  },
  {
    id: 'studio-shelf',
    src: '/images/moodboard/studio-shelf.webp',
    alt: 'A view of the workshop shelf',
    x: 262,
    y: 340,
    w: 196,
    r: -5,
    z: 1,
  },
  {
    id: 'lucky',
    src: '/images/moodboard/lucky.webp',
    alt: 'A small card reading "lucky" in script',
    x: 418,
    y: 528,
    w: 140,
    r: 7,
    z: 6,
  },
  {
    id: 'stitching-closeup',
    src: '/images/moodboard/stitching-closeup.webp',
    alt: 'A hand cutting a leather journal cover on a blue work surface',
    x: 572,
    y: 350,
    w: 220,
    r: 6,
    z: 5,
    dots: [
      { color: '#7a2e35', corner: 'bl' },
      { color: '#e7dcc3', corner: 'bl', size: 1.6, offset: 2.4 },
    ],
  },
];
---

<section class="moodboard" aria-label="Behind the journals">
  <p class="moodboard__kicker">From the workbench</p>

  <div class="moodboard__board" id="moodboard-board">
    {
      tiles.map((t) => (
        <figure
          class="moodboard__tile"
          data-tile={t.id}
          style={`left:${t.x}px; top:${t.y}px; width:${t.w}px; --r:${t.r}deg; z-index:${t.z};`}
        >
          {t.dots?.map((d) => (
            <span
              class={`dot dot--${d.corner}`}
              style={`background:${d.color}; width:${d.size ?? 2.8}rem; height:${d.size ?? 2.8}rem; --dot-offset:${d.offset ?? -0.9}rem;`}
              aria-hidden="true"
            />
          ))}
          <img src={t.src} alt={t.alt} loading="lazy" draggable="false" />
        </figure>
      ))
    }
  </div>

  <div class="moodboard__title">
    <span class="moodboard__label">Handmade</span>
    <h2 class="moodboard__heading">
      <span class="moodboard__heading-top">The</span>
      <span class="moodboard__heading-bottom">Journal</span>
    </h2>
    <span class="moodboard__label">One of one</span>
  </div>
</section>

<script>
  // Each tile is free-dragged with pointer events (covers mouse + touch in
  // one code path) rather than HTML5 drag-and-drop, which fights you on
  // touch and insists on a ghost-image UI nobody wants here. Only active on
  // the scattered desktop/tablet layout — see the @media cutoff in the
  // style block — the mobile fallback is a plain stacked list.
  const STORAGE_KEY = 'journal-moodboard:v1';

  function savePositions(board) {
    const positions = {};
    board.querySelectorAll('.moodboard__tile').forEach((tile) => {
      const id = tile.dataset.tile;
      if (!id) return;
      positions[id] = { left: tile.style.left, top: tile.style.top, z: tile.style.zIndex };
    });
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(positions));
    } catch {
      // Private browsing / storage full — the board just won't remember a
      // rearrangement across reloads, which is fine.
    }
  }

  function restorePositions(board) {
    let saved = null;
    try {
      saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
    } catch {
      saved = null;
    }
    if (!saved) return;
    board.querySelectorAll('.moodboard__tile').forEach((tile) => {
      const id = tile.dataset.tile;
      const p = id ? saved[id] : undefined;
      if (p) {
        tile.style.left = p.left;
        tile.style.top = p.top;
        tile.style.zIndex = p.z;
      }
    });
  }

  function initMoodboard() {
    const board = document.getElementById('moodboard-board');
    if (!board) return;

    // Dragging is a desktop/tablet thing — the mobile layout stacks tiles
    // full-width in normal flow, where left/top positioning (and therefore
    // dragging) has nothing to act on.
    if (window.matchMedia('(max-width: 860px)').matches) return;

    restorePositions(board);

    let topZ = 10;
    board.querySelectorAll('.moodboard__tile').forEach((tile) => {
      let dragging = false;
      let startX = 0;
      let startY = 0;
      let origLeft = 0;
      let origTop = 0;

      tile.addEventListener('pointerdown', (e) => {
        dragging = true;
        tile.setPointerCapture(e.pointerId);
        tile.classList.add('is-dragging');
        topZ += 1;
        tile.style.zIndex = String(topZ);
        startX = e.clientX;
        startY = e.clientY;
        origLeft = tile.offsetLeft;
        origTop = tile.offsetTop;
      });

      tile.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        tile.style.left = `${origLeft + (e.clientX - startX)}px`;
        tile.style.top = `${origTop + (e.clientY - startY)}px`;
      });

      const stopDrag = (e) => {
        if (!dragging) return;
        dragging = false;
        tile.classList.remove('is-dragging');
        tile.releasePointerCapture(e.pointerId);
        savePositions(board);
      };
      tile.addEventListener('pointerup', stopDrag);
      tile.addEventListener('pointercancel', stopDrag);
    });
  }

  initMoodboard();
  document.addEventListener('astro:page-load', initMoodboard);
</script>

<style>
  .moodboard {
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2rem) clamp(3rem, 6vw, 5rem);
  }

  .moodboard__kicker {
    display: block;
    margin: 0 0 1.5rem;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Fixed pixel canvas, not a fluid grid — the scattered layout above is
     hand-placed for this exact size. Below 860px (see the media query) we
     drop it entirely for a plain stacked column instead of trying to
     rescale free-form coordinates onto a phone screen. */
  .moodboard__board {
    position: relative;
    width: 100%;
    max-width: 820px;
    height: 680px;
    margin: 0 auto;
  }

  .moodboard__tile {
    position: absolute;
    margin: 0;
    line-height: 0;
    transform: rotate(var(--r, 0deg));
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
    cursor: grab;
    touch-action: none;
    user-select: none;
    transition: box-shadow 0.15s ease;
  }

  .moodboard__tile img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .moodboard__tile.is-dragging {
    cursor: grabbing;
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28);
    transition: none;
  }

  /* Decorative accent circles — color comes from each tile's own dot entry
     above (sampled from the shop's own leather flat-lay, not invented).
     The corner classes only set which corner; --dot-offset lets a tile push
     a second, smaller dot further out so a pair reads as layered rather
     than stacked exactly on top of each other. */
  .dot {
    position: absolute;
    z-index: 1;
    border-radius: 50%;
    pointer-events: none;
  }

  .dot--tl {
    top: var(--dot-offset, -0.9rem);
    left: var(--dot-offset, -0.9rem);
  }

  .dot--tr {
    top: var(--dot-offset, -0.9rem);
    right: var(--dot-offset, -0.9rem);
  }

  .dot--bl {
    bottom: var(--dot-offset, -0.9rem);
    left: var(--dot-offset, -0.9rem);
  }

  .dot--br {
    bottom: var(--dot-offset, -0.9rem);
    right: var(--dot-offset, -0.9rem);
  }

  .moodboard__title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 4vw, 2.5rem);
    margin-top: clamp(1.5rem, 4vw, 3rem);
    text-align: center;
  }

  .moodboard__label {
    flex: 1;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .moodboard__label:first-child {
    text-align: right;
  }

  .moodboard__label:last-child {
    text-align: left;
  }

  .moodboard__heading {
    flex-shrink: 0;
    margin: 0;
    line-height: 0.95;
  }

  .moodboard__heading-top {
    display: block;
    font-family: var(--display);
    text-transform: uppercase;
    font-size: clamp(1.4rem, 4vw, 2rem);
    letter-spacing: 0.02em;
  }

  .moodboard__heading-bottom {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(3rem, 10vw, 5.5rem);
  }

  /* Below this, the hand-placed canvas doesn't have room to work with —
     drop back to a plain stacked column (still slightly rotated per tile
     for texture, just not draggable or overlapping). */
  @media (max-width: 860px) {
    .moodboard__board {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 26rem;
    }

    .moodboard__tile {
      position: static !important;
      width: 100% !important;
      cursor: default;
      touch-action: auto;
    }

    .moodboard__label {
      display: none;
    }
  }
</style>
