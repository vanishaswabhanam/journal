---
// A hand-assembled "mood board" for the Journal page — process shots, a
// material flat-lay, and a stamp-style text card, arranged in the same
// staggered 3-column order as the moodboard-collage reference this was
// built from. Flat, axis-aligned tiles (no rotation, no shadow/border) —
// the reference's own tiles are plain rectangles; the texture comes from
// the photos and the accent dots, not a frame around them.
//
// Every tile is still draggable (see the script below): the 3-column order
// below is the *resting* layout, measured from real rendered positions so
// it's always correct for whatever aspect ratio each photo happens to be,
// then frozen into absolute coordinates a visitor can drag from.
//
// Images live in public/images/moodboard/ — see CONTENT.md if more get
// added later. Dot colors are sampled from the leather flat-lay and the
// stamp card's own parchment tone, not invented.
---

<section class="moodboard" aria-label="Behind the journals">
  <p class="moodboard__kicker">From the workbench</p>

  <div class="moodboard__board" id="moodboard-board">
    <div class="moodboard__columns">
      <div class="moodboard__col">
        <figure class="moodboard__tile" data-tile="stitching-closeup">
          <span class="dot dot--tl" style="background:#65313e;" aria-hidden="true"></span>
          <img
            src="/images/moodboard/stitching-closeup.webp"
            alt="A hand cutting a leather journal cover on a blue work surface"
            loading="lazy"
            draggable="false"
          />
        </figure>
        <figure class="moodboard__tile" data-tile="stamp-card">
          <span class="dot dot--br" style="background:#bdb897;" aria-hidden="true"></span>
          <img
            src="/images/moodboard/stamp-card.webp"
            alt="A stamp-style card reading: Leather Journals, handmade with love and care, one of one, hand-stitched pockets, suede inserts, made by Vanisha"
            loading="lazy"
            draggable="false"
          />
        </figure>
      </div>

      <div class="moodboard__col moodboard__col--tall">
        <figure class="moodboard__tile" data-tile="floral-sketch">
          <span class="dot dot--tr" style="background:#5c7a6e;" aria-hidden="true"></span>
          <img
            src="/images/moodboard/floral-sketch.webp"
            alt="A hand-painted floral illustration in cream on deep red"
            loading="lazy"
            draggable="false"
          />
        </figure>
        <figure class="moodboard__tile" data-tile="lucky">
          <img src="/images/moodboard/lucky.webp" alt="A small card reading &quot;lucky&quot; in script" loading="lazy" draggable="false" />
        </figure>
      </div>

      <div class="moodboard__col">
        <!-- This is the shop's own stamp-shaped photo — the scalloped
             perforated edge is baked into the photo itself, not built in
             CSS. Text just sits on top of its own blank parchment space,
             above and below the three leather flower cutouts. -->
        <figure class="moodboard__tile moodboard__stamp-photo" data-tile="studio-shelf">
          <span class="dot dot--tl" style="background:#835233;" aria-hidden="true"></span>
          <img
            src="/images/moodboard/studio-shelf.webp"
            alt="A stamp-shaped parchment card with three leather flower cutouts, overlaid with shop details"
            loading="lazy"
            draggable="false"
          />
          <div class="stamp-overlay stamp-overlay--top">
            <p class="stamp__eyebrow">Leather Journals</p>
            <p class="stamp__big">
              Now taking<br />
              orders
            </p>
          </div>
          <div class="stamp-overlay stamp-overlay--bottom">
            <p class="stamp__line">Handmade &middot; one of one</p>
            <p class="stamp__small">Shop the full collection on this site</p>
          </div>
        </figure>
        <figure class="moodboard__tile" data-tile="pattern-clips">
          <img
            src="/images/moodboard/pattern-clips.webp"
            alt="A finished journal held open with binder clips next to its stitching pattern"
            loading="lazy"
            draggable="false"
          />
        </figure>
        <figure class="moodboard__tile" data-tile="leather-swatches">
          <span class="dot dot--bl" style="background:#e7dcc3;" aria-hidden="true"></span>
          <img
            src="/images/moodboard/leather-swatches.webp"
            alt="A flat lay of cut leather pieces in different colors and textures"
            loading="lazy"
            draggable="false"
          />
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  // Two passes: first let the tiles lay out normally (CSS flex columns),
  // in the same proper top-row/bottom-row order as the reference this is
  // built from — so the resting order is always right no matter what size
  // a given photo is. Then measure each tile's real rendered position and
  // freeze it as an absolute coordinate, which is what makes dragging
  // possible. Only on desktop/tablet — the mobile layout stays a plain
  // stacked column with nothing to drag.
  const STORAGE_KEY = 'journal-moodboard:v2';

  function freezeLayout(board) {
    const boardRect = board.getBoundingClientRect();
    const tiles = Array.from(board.querySelectorAll('.moodboard__tile'));

    // Measure every tile's resting position FIRST, all still in normal
    // flow — pulling even one tile out to `position: absolute` mid-loop
    // reflows its siblings, so measuring and mutating in the same pass
    // throws off every tile measured afterward.
    const rects = tiles.map((tile) => tile.getBoundingClientRect());

    board.style.height = `${board.scrollHeight}px`;

    tiles.forEach((tile, i) => {
      const rect = rects[i];
      tile.style.position = 'absolute';
      tile.style.left = `${rect.left - boardRect.left}px`;
      tile.style.top = `${rect.top - boardRect.top}px`;
      tile.style.width = `${rect.width}px`;
      tile.style.margin = '0';
    });
  }

  function savePositions(board) {
    const positions = {};
    board.querySelectorAll('.moodboard__tile').forEach((tile) => {
      const id = tile.dataset.tile;
      if (!id) return;
      positions[id] = { left: tile.style.left, top: tile.style.top, z: tile.style.zIndex };
    });
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(positions));
    } catch {
      // Private browsing / storage full — the board just won't remember a
      // rearrangement across reloads, which is fine.
    }
  }

  function restorePositions(board) {
    let saved = null;
    try {
      saved = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? 'null');
    } catch {
      saved = null;
    }
    if (!saved) return;
    board.querySelectorAll('.moodboard__tile').forEach((tile) => {
      const id = tile.dataset.tile;
      const p = id ? saved[id] : undefined;
      if (p) {
        tile.style.left = p.left;
        tile.style.top = p.top;
        tile.style.zIndex = p.z;
      }
    });
  }

  function initMoodboard() {
    const board = document.getElementById('moodboard-board');
    if (!board) return;

    if (window.matchMedia('(max-width: 860px)').matches) return;

    freezeLayout(board);
    restorePositions(board);

    let topZ = 10;
    board.querySelectorAll('.moodboard__tile').forEach((tile) => {
      let dragging = false;
      let startX = 0;
      let startY = 0;
      let origLeft = 0;
      let origTop = 0;

      tile.addEventListener('pointerdown', (e) => {
        dragging = true;
        tile.setPointerCapture(e.pointerId);
        tile.classList.add('is-dragging');
        topZ += 1;
        tile.style.zIndex = String(topZ);
        startX = e.clientX;
        startY = e.clientY;
        origLeft = tile.offsetLeft;
        origTop = tile.offsetTop;
      });

      tile.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        tile.style.left = `${origLeft + (e.clientX - startX)}px`;
        tile.style.top = `${origTop + (e.clientY - startY)}px`;
      });

      const stopDrag = (e) => {
        if (!dragging) return;
        dragging = false;
        tile.classList.remove('is-dragging');
        tile.releasePointerCapture(e.pointerId);
        savePositions(board);
      };
      tile.addEventListener('pointerup', stopDrag);
      tile.addEventListener('pointercancel', stopDrag);
    });
  }

  initMoodboard();
  document.addEventListener('astro:page-load', initMoodboard);
</script>

<style>
  /* Bold, rounded, friendly sans for the stamp card — the same kind of
     geometric display face Canva's own templates lean on (closest
     self-hostable match: Baloo 2). Distinct from --display (Anton, the
     site's tall condensed wordmark voice) and --mono (Special Elite,
     typewriter) — this one is specifically for this one stamp-style card. */
  @font-face {
    font-family: 'Baloo 2';
    src: url('/fonts/baloo2-bold-latin.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  .moodboard {
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2rem) clamp(3rem, 6vw, 5rem);
  }

  .moodboard__kicker {
    display: block;
    margin: 0 0 1.5rem;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .moodboard__board {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
  }

  .moodboard__columns {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    align-items: flex-start;
  }

  .moodboard__col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  /* The middle column carries the tallest single image plus a nested pair
     below it, so it naturally reads taller than its neighbors — that
     stagger is the "proper order" from the reference, not a grid. */
  .moodboard__col--tall {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .moodboard__tile {
    position: relative;
    margin: 0;
    line-height: 0;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .moodboard__tile img {
    display: block;
    width: 100%;
    height: auto;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .moodboard__tile.is-dragging {
    cursor: grabbing;
  }

  /* Decorative accent circles — colors sampled from the leather flat-lay
     and the stamp card's parchment tone (see the component comment above).
     Corner placement always picks the edge facing open background: the
     top edge for a tile that's first in its column, the bottom edge for
     one that's last — a dot on the edge facing a neighboring tile across
     the gap reads as a stray floating circle instead of a corner accent. */
  .dot {
    position: absolute;
    z-index: 2;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 50%;
    pointer-events: none;
  }

  .dot--tl {
    top: var(--dot-offset, -1rem);
    left: var(--dot-offset, -1rem);
  }

  .dot--tr {
    top: var(--dot-offset, -1rem);
    right: var(--dot-offset, -1rem);
  }

  .dot--bl {
    bottom: var(--dot-offset, -1rem);
    left: var(--dot-offset, -1rem);
  }

  .dot--br {
    bottom: var(--dot-offset, -1rem);
    right: var(--dot-offset, -1rem);
  }

  /* Text sits directly on the shop's own stamp-shaped photo — above and
     below the three leather flower cutouts, in the blank parchment space
     that's already part of the image. Positioned by percentage of the
     photo's own height, not a fixed px, so it stays in that blank area
     regardless of the tile's rendered size. */
  .stamp-overlay {
    position: absolute;
    left: 12%;
    right: 12%;
    text-align: center;
    color: #2a2a1f;
    font-family: 'Baloo 2', sans-serif;
    line-height: 1.15;
  }

  .stamp-overlay--top {
    top: 11%;
  }

  .stamp-overlay--bottom {
    top: 47%;
  }

  .stamp__eyebrow {
    margin: 0 0 0.3rem;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .stamp__big {
    margin: 0;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    text-transform: uppercase;
  }

  .stamp__line {
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .stamp__small {
    margin: 0;
    font-size: 0.68rem;
    opacity: 0.8;
  }

  @media (max-width: 860px) {
    .moodboard__board {
      height: auto !important;
    }

    .moodboard__columns {
      flex-direction: column;
    }

    .moodboard__col--tall {
      margin-top: 0;
    }

    .moodboard__tile {
      position: static !important;
      width: 100% !important;
      cursor: default;
      touch-action: auto;
    }

    /* Needs to stay a positioned ancestor even on mobile — the overlay
       text is absolutely positioned inside it. */
    .moodboard__stamp-photo {
      position: relative !important;
    }
  }
</style>
