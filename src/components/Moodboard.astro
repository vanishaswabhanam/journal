---
// The "Journal" page's photo grid — a flat 3x2 layout of process/flat-lay
// polaroids, no captions, no intro copy, no rotation or drag. Images live
// in public/images/poloroids/.
---

<section class="moodboard" aria-label="Behind the journals">
  <div class="moodboard__grid">
    <img src="/images/poloroids/laptop-wallet.png" alt="" />
    <img src="/images/poloroids/cross-stitch-clip.png" alt="" />
    <img src="/images/poloroids/wallet-row.png" alt="" />
    <img src="/images/poloroids/floral-painting.png" alt="" />
    <img src="/images/poloroids/stamp-card-photo.png" alt="" />
    <img src="/images/poloroids/leather-swatches.png" alt="" />
  </div>
</section>

<style>
  .moodboard {
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 4vw, 2rem) clamp(3rem, 6vw, 5rem);
  }

  .moodboard__grid {
    max-width: 620px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .moodboard__grid img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 860px) {
    .moodboard__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .moodboard__grid {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
  }
</style>
