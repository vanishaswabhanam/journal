---
// The product-page media viewer. Photos (and the walkthrough video, if any)
// live in a smoothly scrollable pane — scroll or swipe through them
// directly, or click a thumbnail to jump straight to one. No crossfade
// trick, no hidden/shown swapping: it's just a real scrollable list, which
// is what makes it feel natural instead of "clicky."
//
// The first photo carries the same `transition:name` as its grid card (see
// JournalCard.astro), so clicking a journal in the shop grid smoothly
// morphs that photo into this page's first slide instead of a hard cut.
import type { Journal } from '../lib/journals';
import { thumbOf, posterOf } from '../lib/journals';

interface Props {
  journal: Journal;
}

const { journal } = Astro.props;

const heroSrc = journal.hero ?? journal.image;
const heroThumb = journal.hero ? thumbOf(journal.hero) : journal.image;

type Item = { type: 'image' | 'video'; src: string; thumb: string; alt: string };

const items: Item[] = [
  { type: 'image', src: heroSrc, thumb: heroThumb, alt: journal.name },
  ...journal.gallery.map((src, i) => ({
    type: 'image' as const,
    src,
    thumb: thumbOf(src),
    alt: `${journal.name}, detail ${i + 1}`,
  })),
  ...(journal.video
    ? [{ type: 'video' as const, src: journal.video, thumb: posterOf(journal.video), alt: `${journal.name}, walkthrough` }]
    : []),
];

const multiple = items.length > 1;
---

<div class="gallery" data-gallery>
  {multiple && (
    <div class="gallery__thumbs" role="tablist" aria-label={`${journal.name} views`}>
      {items.map((item, i) => (
        <button
          type="button"
          class="gallery__thumb"
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={item.type === 'video' ? `Jump to ${journal.name} walkthrough` : `Jump to ${item.alt}`}
        >
          <img src={item.thumb} alt="" loading="lazy" />
          {item.type === 'video' && <span class="gallery__play" aria-hidden="true"></span>}
        </button>
      ))}
    </div>
  )}

  <div class="gallery__viewport">
    <div class="gallery__scroller" data-scroller>
      {items.map((item, i) => (
        <div class="gallery__slide" data-index={i}>
          {item.type === 'video' ? (
            <video class="gallery__media" src={item.src} muted loop playsinline preload="metadata" />
          ) : (
            <img
              class="gallery__media"
              src={item.src}
              alt={item.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              transition:name={i === 0 ? `product-image:${journal.href}` : undefined}
            />
          )}
        </div>
      ))}
    </div>

    {multiple && (
      <>
        <button type="button" class="gallery__arrow gallery__arrow--prev" data-dir="-1" aria-label={`Previous photo of ${journal.name}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18" /></svg>
        </button>
        <button type="button" class="gallery__arrow gallery__arrow--next" data-dir="1" aria-label={`Next photo of ${journal.name}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18" /></svg>
        </button>
      </>
    )}
  </div>

  {journal.sold && <span class="gallery__sold-badge">Sold out</span>}
</div>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
      if (gallery.dataset.wired) return;
      gallery.dataset.wired = 'true';

      const scroller = gallery.querySelector<HTMLElement>('[data-scroller]');
      const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery__slide'));
      const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery__thumb'));
      if (!scroller || slides.length === 0) return;

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const slide = slides[Number(thumb.dataset.index)];
          slide?.scrollIntoView({ behavior: 'smooth', block: 'start', inline: 'start' });
        });
      });

      // Arrows just step the currently-selected thumbnail by one, reusing
      // the same scrollIntoView jump a thumbnail click does. There's no
      // prev arrow on the first photo and no next arrow on the last one,
      // since there's nowhere left to step.
      const prevArrow = gallery.querySelector<HTMLButtonElement>('.gallery__arrow--prev');
      const nextArrow = gallery.querySelector<HTMLButtonElement>('.gallery__arrow--next');
      const arrows = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery__arrow'));

      function updateArrows(index: number) {
        if (prevArrow) prevArrow.hidden = index <= 0;
        if (nextArrow) nextArrow.hidden = index >= slides.length - 1;
      }
      updateArrows(0);

      arrows.forEach((arrow) => {
        arrow.addEventListener('click', () => {
          const current = thumbs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
          const next = Math.min(Math.max(current + Number(arrow.dataset.dir), 0), slides.length - 1);
          slides[next]?.scrollIntoView({ behavior: 'smooth', block: 'start', inline: 'start' });
        });
      });

      // Keep the selected thumbnail and video playback in sync with
      // whichever slide is actually in view, however the user got there
      // (scroll, swipe, or a thumbnail click).
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const index = (entry.target as HTMLElement).dataset.index;
            const video = entry.target.querySelector('video');
            if (entry.intersectionRatio > 0.6) {
              thumbs.forEach((t) => t.setAttribute('aria-selected', t.dataset.index === index ? 'true' : 'false'));
              updateArrows(Number(index));
              video?.play().catch(() => {});
            } else {
              video?.pause();
            }
          }
        },
        { root: scroller, threshold: [0, 0.6, 1] },
      );
      slides.forEach((slide) => observer.observe(slide));
    });
  }

  initGalleries();
  document.addEventListener('astro:page-load', initGalleries);
</script>

<style>
  .gallery {
    position: relative;
    display: flex;
    gap: 1.1rem;
    height: 100%;
  }

  .gallery__thumbs {
    display: flex;
    flex-direction: column;
    /* A little breathing room between thumbnails instead of them touching. */
    gap: 0.5rem;
    flex-shrink: 0;
    width: clamp(56px, 6vw, 80px);
    overflow-y: auto;
    /* This list can overflow its height when there are enough photos —
       without this, the browser's own scrollbar shows up right next to
       it, which at this narrow a width reads as huge. The scroller pane
       hides its scrollbar the same way, a few rules down. */
    scrollbar-width: none;
  }

  .gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  .gallery__thumb {
    position: relative;
    display: block;
    width: 100%;
    flex-shrink: 0;
    padding: 0;
    border: none;
    background: var(--bg);
    cursor: pointer;
    overflow: hidden;
    /* No fixed aspect-ratio — the box takes the shape of its own photo
       (see the img rule below), so a landscape insert shot gets a short
       wide box instead of being letterboxed inside a tall portrait one
       with a lot of empty space top and bottom. */
  }

  .gallery__thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__play::before {
    content: '';
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .gallery__play::after {
    content: '';
    position: absolute;
    border-style: solid;
    border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent #111;
    margin-left: 2px;
  }

  /* A non-scrolling positioning wrapper around the scroller, so the arrows
     can sit fixed in place (left/right, vertically centered) instead of
     scrolling away with the slide underneath them. */
  .gallery__viewport {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 100%;
  }

  /* The actual browsable area: a real scroll container, not a fake one —
     mouse wheel, trackpad, keyboard, and touch all just work. */
  .gallery__scroller {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
  }

  /* Really minimal, light chevrons, just a thin stroke with no circle or
     backdrop. Faint by default so they don't compete with the photo, a
     touch more present on hover/focus.

     Positioned to match whichever way the gallery actually scrolls: on
     desktop the scroller moves top to bottom, so the arrows sit above and
     below, pointing up/down (the svg chevrons are drawn pointing
     left/right, rotated 90deg here to match). The mobile media query
     below swaps both the position and the rotation back to left/right,
     since mobile swipes side to side instead. */
  .gallery__arrow {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: none;
    color: var(--ink);
    opacity: 0.35;
    cursor: pointer;
    transition: opacity 0.15s ease;
    z-index: 1;
  }

  .gallery__arrow svg {
    width: 20px;
    height: 20px;
    transform: rotate(90deg);
  }

  .gallery__arrow:hover,
  .gallery__arrow:focus-visible {
    opacity: 0.8;
  }

  .gallery__arrow--prev {
    top: 0.25rem;
  }

  .gallery__arrow--next {
    bottom: 0.25rem;
  }

  .gallery__scroller::-webkit-scrollbar {
    display: none;
  }

  .gallery__slide {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__media {
    max-width: 88%;
    max-height: 88%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .gallery__sold-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    z-index: 1;
  }

  @media (max-width: 860px) {
    .gallery {
      flex-direction: column;
      height: auto;
    }

    /* On mobile the gallery swipes horizontally instead of scrolling
       vertically — that way it never fights the page's own scroll. */
    .gallery__viewport {
      order: 1;
      height: auto;
      width: 100%;
      aspect-ratio: 4 / 5;
    }

    .gallery__scroller {
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
    }

    /* Mobile swipes left/right, so the arrows move to the sides
       (vertically centered) and the chevrons point left/right again
       instead of up/down. */
    .gallery__arrow {
      left: auto;
      top: 50%;
      transform: translateY(-50%);
    }

    .gallery__arrow svg {
      transform: none;
    }

    .gallery__arrow--prev {
      left: 0.25rem;
    }

    .gallery__arrow--next {
      right: 0.25rem;
      bottom: auto;
    }

    .gallery__slide {
      width: 100%;
      height: 100%;
    }

    .gallery__thumbs {
      order: 2;
      flex-direction: row;
      /* Cross-axis is height in a row, which flexbox stretches to match
         by default — override that so each thumb keeps its own photo's
         shape instead of every box being forced to the tallest one. */
      align-items: flex-start;
      width: 100%;
      overflow-x: auto;
      overflow-y: visible;
      padding-bottom: 0.2rem;
    }

    .gallery__thumb {
      width: auto;
      height: 64px;
    }

    .gallery__thumb img {
      width: auto;
      height: 100%;
    }
  }
</style>
