---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <SiteHeader />
    <main class="page">
      <slot />
    </main>

    <style is:global>
      :root {
        --bg: #ebebeb;
        --line: #808080;
        --line-soft: rgba(0, 0, 0, 0.12);
        --ink: #111;
        --muted: #6b6b6b;
        --serif: Georgia, 'Times New Roman', Times, serif;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        /* Header proportions measured from the original design (all in vw,
           so the whole page scales together like the original). */
        --header-height: 11.1vw;
        --nav-word-height: 7.75vw;
        --gutter: 1.65vw;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Helvetica,
          Arial,
          sans-serif;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }

      img {
        max-width: 100%;
      }

      a {
        color: inherit;
      }

      .page {
        padding-top: var(--header-height);
      }
    </style>
  </body>
</html>
