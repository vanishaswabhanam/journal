---
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  // Per-page override for the meta description / social preview text.
  // Falls back to one line about the shop as a whole — good enough for
  // any page that doesn't set its own.
  description?: string;
  // Per-page social preview photo (root-relative, e.g. a journal's own
  // hero shot) — passed by journals/[slug].astro so sharing a product
  // link shows that journal, not a generic shop image. Falls back to one
  // flagship product photo for every page that doesn't set its own.
  image?: string;
}

const {
  title,
  description = 'Handmade leather journals, one of one, hand-stitched, not mass-produced.',
  image = '/images/products/the-oxblood/hero.webp',
} = Astro.props;

// Absolute URLs — og:image/twitter:image and canonical both need a full
// URL, not a root-relative path; a relative one silently fails as a
// social preview image on platforms that don't resolve it against the page.
const canonicalURL = new URL(Astro.url.pathname, site.url).toString();
const socialImageURL = new URL(image, site.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mobile Safari tints its status bar / toolbar chrome to match this —
         Cart.astro flips it to the popup's white (--paper) while the cart
         drawer or receipt is open, and back to the page's gray (--bg) when
         closed, so the phone's own UI blends with whatever's on screen
         instead of showing a mismatched gray strip above/below a white
         popup. -->
    <meta name="theme-color" content="#ebebeb" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImageURL} />
    <!-- The real logo now — black by default, swapping to the white cutout
         when the browser chrome itself is dark (prefers-color-scheme), so
         the tab icon stays visible in both. -->
    <link rel="icon" href="/favicon-black.png" type="image/png" />
    <link rel="icon" href="/favicon-white.png" type="image/png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Without this, the browser doesn't discover these fonts until it
         parses the CSS that references them (after the stylesheet below),
         so the header is visible in a fallback system font for a beat and
         then visibly snaps to Anton once it loads — that snap is what's
         been showing up as a "weird font" flash, worst on the header since
         it's on every page. Preloading starts the fetch immediately,
         alongside the HTML itself, so the real font is normally ready
         before first paint instead of swapping in after it. All three are
         tiny (7-53KB) — cheap to load regardless of whether this page
         even uses all of them. -->
    <link rel="preload" href="/fonts/anton-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/special-elite-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-semibold-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Powers the shared-element morph: a journal's grid photo smoothly
         growing into the product page's hero photo on click, instead of a
         hard cut (the data-morph markers on JournalCard.astro and
         ProductGallery.astro, tagged per navigation by the script at the
         bottom of this file). Pulled earlier this session while
         chasing a click/refresh glitch, then added back — the morph
         itself was missed, and the dev toolbar (now disabled, see
         astro.config.mjs) is the more likely actual culprit for that
         glitch, not this. -->
    <ClientRouter />
    <!-- Every page/component script here is a separately-hashed build
         file; a tab left open from before a new deploy can ask the live
         site for a hash that deploy no longer has (a 404 for something
         like /_astro/Cart.*.js), breaking whatever that chunk ran — most
         visibly, the cart. vite:preloadError is Vite's own event for
         exactly that failure (fired when ClientRouter's soft navigation
         tries to load a page's script and the hash is gone); reloading
         fetches the current deploy's HTML, which only ever references
         hashes that current deploy actually has. -->
    <script is:inline>
      window.addEventListener('vite:preloadError', () => {
        window.location.reload();
      });
    </script>
  </head>
  <body>
    <SiteHeader />
    <main class="page">
      <slot />
    </main>
    <NewsletterSignup />

    <script>
      // Going back to the shop from a product page should land you where
      // you were (same tab, same spot in the grid), not at the top.
      // The browser's back button already does that: Astro's page
      // transitions remember each page's scroll position. But "← Shop"
      // and the header's SHOP are plain links to "/", which open the
      // shop fresh at the top.
      //
      // So: when you open a product from the shop grid, remember which
      // product that was. On that product's page, those two Shop links
      // just step back instead. Anything else (landing on a product page
      // from a shared link, pressing SHOP while already on the shop) is
      // left as a normal link.
      const KEY = 'hidest:opened-from-shop';
      const isProduct = (path: string) => /^\/(journals|pouches)\/[^/]+\/$/.test(path);

      document.addEventListener('astro:before-preparation', (e) => {
        try {
          if (e.from.pathname === '/' && isProduct(e.to.pathname) && e.navigationType === 'push') {
            sessionStorage.setItem(KEY, e.to.pathname);
          }
        } catch {
          // storage unavailable (private mode etc.): Shop links stay plain links
        }
      });

      // The photo morph between a grid card and its product page. Only the
      // one photo that's actually morphing may carry a view-transition
      // name: the browser lifts every named element onto a layer above the
      // whole page for the length of the animation, so when every card was
      // named, all the other journals on screen floated over the header and
      // tab bar mid-transition. Cards and the product page's main photo
      // just carry a data-morph marker (their product's URL); each
      // navigation names only the one matching the product being opened
      // (or returned from), on the old page and on the incoming one.
      const MORPH = 'product-morph';
      let morphPath: string | null = null;
      const nameMorph = (doc: Document) => {
        doc.querySelectorAll<HTMLElement>('[data-morph]').forEach((el) => {
          el.style.viewTransitionName = el.dataset.morph === morphPath ? MORPH : '';
        });
      };
      document.addEventListener('astro:before-preparation', (e) => {
        morphPath = isProduct(e.to.pathname) ? e.to.pathname : isProduct(e.from.pathname) ? e.from.pathname : null;
        nameMorph(document);
      });
      document.addEventListener('astro:before-swap', (e) => nameMorph(e.newDocument));

      // Capture phase, so this runs before Astro's own link handling and
      // can take over the click.
      document.addEventListener(
        'click',
        (e) => {
          const link = (e.target as Element | null)?.closest?.('a[href]');
          if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const to = new URL((link as HTMLAnchorElement).href, location.href);
          if (to.origin !== location.origin || to.pathname !== '/') return;
          let openedFromShop = null;
          try {
            openedFromShop = sessionStorage.getItem(KEY);
          } catch {}
          if (!isProduct(location.pathname) || openedFromShop !== location.pathname) return;
          e.preventDefault();
          e.stopPropagation();
          try {
            sessionStorage.removeItem(KEY);
          } catch {}
          history.back();
        },
        true,
      );
    </script>

    <style is:global>
      /* Anton is the site's one graphic gesture — the same bold, tall,
         condensed energy as the JOURNAL/SHOP/CONTACT wordmark images (which
         are custom lettering, not a font, so this is the closest web-font
         match to reuse elsewhere: product names, the cart's brand header).
         Self-hosted rather than linked to Google Fonts — one small file,
         one less external dependency, no runtime network request. */
      @font-face {
        font-family: 'Anton';
        src: url('/fonts/anton-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      /* The promo cards' stamp/catalog-label typography (PromoCard.astro)
         needed a hand-inked typewriter voice distinct from --display and
         --serif — self-hosted the same way as Anton above, one small file,
         no Google Fonts runtime request. Special Elite only ships one
         weight (400); it's a worn-typewriter face, not a bold display one. */
      @font-face {
        font-family: 'Special Elite';
        src: url('/fonts/special-elite-latin.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      /* Used only to set the word "Moleskine" wherever it's named as part
         of what a journal includes (ProductInfo.astro) — a geometric
         grotesque at a medium-bold weight, the closest free look-alike
         available to Moleskine's own wordmark, so the brand name reads as
         a nod to their actual logo instead of generic body text. Not
         their real typeface (that's licensed, not something to lift),
         just a close visual match. */
      @font-face {
        font-family: 'Archivo Semibold';
        src: url('/fonts/archivo-semibold-latin.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg: #ebebeb;
        --line: #808080;
        --line-soft: rgba(0, 0, 0, 0.12);
        --ink: #111;
        --muted: #6b6b6b;
        --paper: #fff;
        --serif: Georgia, 'Times New Roman', Times, serif;
        /* The site's one bold display voice — see the @font-face above.
           Falls back to a tall condensed system sans if the file fails to
           load, so the hierarchy still reads even without it. */
        --display: 'Anton', 'Arial Narrow', sans-serif;
        /* Hand-inked typewriter/stamp voice — see the @font-face above.
           Falls back to a system monospace stack, which keeps the same
           "label" feel even unstyled. */
        --mono: 'Special Elite', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        /* One error tone for inline form feedback (contact page, cart's
           send-request step) — a warm oxblood/rust rather than a stock
           alert red, so it still reads as part of this palette. */
        --error: #8a3324;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        /* Header proportions measured from the original design (all in vw,
           so the whole page scales together like the original). */
        --header-height: 11.1vw;
        --nav-word-height: 7.75vw;
        --gutter: 1.65vw;
      }

      * {
        box-sizing: border-box;
      }

      /* Browsers draw their own feedback on tap/click by default — iOS
         Safari flashes a gray/blue highlight over whatever you tapped,
         and desktop browsers draw a focus outline on click too, not just
         keyboard nav. Both look like a bolted-on default UI, and the
         focus outline specifically reads as a second, thicker line right
         next to the grid's own hairline borders. Keep a real indicator
         for keyboard users (:focus-visible); drop it for mouse/touch. */
      a,
      button {
        -webkit-tap-highlight-color: transparent;
      }

      a:focus,
      button:focus {
        outline: none;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Helvetica,
          Arial,
          sans-serif;
      }

      img {
        max-width: 100%;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }

      /* The `hidden` attribute is only respected by default because the
         browser's own stylesheet sets `display: none` for it — any
         component CSS that sets its own `display` on that same element
         (e.g. `.receipt { display: flex }`, so it can be a flex layout
         once shown) silently wins over that at equal specificity, since
         author styles beat the user-agent stylesheet. This keeps `hidden`
         authoritative everywhere, so toggling it is always enough. */
      [hidden] {
        display: none !important;
      }

      a {
        color: inherit;
      }

      .page {
        padding-top: var(--header-height);
      }
    </style>
  </body>
</html>
