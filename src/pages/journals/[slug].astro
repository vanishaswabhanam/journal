---
// One page per journal, generated at build time. The URL, the gallery
// media, and the info panel all come from that journal's file in
// src/content/grid/ — see CONTENT.md.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductInfo from '../../components/ProductInfo.astro';
import { getJournals } from '../../lib/journals';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const journals = await getJournals();
  return journals.map((journal) => ({ params: { slug: journal.slug }, props: { journal } }));
}

const { journal } = Astro.props;
const buyHref = journal.buyLink ?? site.buy.href;
---

<BaseLayout title={`${journal.name} | Leather Journals`}>
  <div class="product">
    <a href="/" class="product__back">
      <span class="product__back-arrow" aria-hidden="true">&larr;</span> Shop
    </a>
    <div class="product__layout">
      <ProductGallery journal={journal} />
      <ProductInfo journal={journal} />
    </div>
  </div>

  <!-- Mobile only: keeps price + buy within thumb's reach while scrolling a long gallery. -->
  <div class="mobile-buy">
    <p class="mobile-buy__price">${journal.price}</p>
    {journal.sold ? (
      <p class="mobile-buy__button mobile-buy__button--sold">Sold out</p>
    ) : (
      <a class="mobile-buy__button" href={buyHref}>{site.buy.label}</a>
    )}
  </div>
</BaseLayout>

<style>
  .product {
    padding: clamp(1.25rem, 4vw, 3rem);
  }

  @media (max-width: 860px) {
    .product {
      padding-bottom: 5.5rem;
    }
  }

  .product__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: inherit;
  }

  .product__back-arrow {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  @media (hover: hover) {
    .product__back:hover .product__back-arrow {
      transform: translateX(-3px);
    }

    .product__back:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .product__layout {
    display: grid;
    /* A fixed-ish width for the gallery column (sized to comfortably fit
       thumbs + the viewport-height-driven image, see ProductGallery.astro)
       rather than stretching to fill leftover width — otherwise, on a wide
       screen, a tall-not-wide portrait photo leaves a canyon of empty
       space before the info column starts. Fixed (not content-sized)
       also matters here: it keeps the info column starting at the same
       x-position on every product page, whether that journal has one
       photo or five — content-sizing this column would shift it around
       per page. The whole layout is capped and centered so it reads as
       one composed unit on wide screens too. */
    grid-template-columns: minmax(0, 32rem) minmax(300px, 28rem);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    max-width: 76rem;
    margin: 0 auto;
  }

  /* Grid items don't shrink below their content's natural width by default,
     which let a long detail-row value push the whole page wider than the
     viewport on narrow screens. This makes them shrink properly instead. */
  .product__layout > :global(*) {
    min-width: 0;
  }

  /* Only the info column gets a reveal animation — the gallery image has
     its own arrival animation (the shared-element morph from the grid, see
     ProductGallery.astro), and layering this on top of that too would
     fight it. */
  .product__layout > :global(*:last-child) {
    animation: product-reveal 0.55s 0.1s var(--ease) both;
  }

  @keyframes product-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product__layout > :global(*:last-child) {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .product__layout {
      grid-template-columns: 1fr;
    }
  }

  .mobile-buy {
    display: none;
  }

  @media (max-width: 860px) {
    .mobile-buy {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 40;
      padding: 0.75rem 1.25rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
      background: var(--bg);
      border-top: 1px solid var(--line-soft);
      box-shadow: 0 -6px 16px rgba(0, 0, 0, 0.08);
    }

    .mobile-buy__price {
      margin: 0;
      font-family: var(--serif);
      font-style: italic;
      font-size: 1.1rem;
      flex-shrink: 0;
    }

    .mobile-buy__button {
      flex: 1;
      max-width: 14rem;
      padding: 0.85rem 1rem;
      border: 1px solid var(--ink);
      background: var(--ink);
      color: #f4f4f2;
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }

    .mobile-buy__button--sold {
      background: transparent;
      border-color: var(--line-soft);
      color: var(--muted);
    }
  }
</style>
