---
// One page per journal, generated at build time — see ProductPage.astro.
import ProductPage from '../../components/ProductPage.astro';
import { getJournals } from '../../lib/journals';

export async function getStaticPaths() {
  const journals = await getJournals();
  return journals.map((journal) => ({ params: { slug: journal.slug }, props: { journal } }));
}

const { journal } = Astro.props;
---

<ProductPage journal={journal} />
