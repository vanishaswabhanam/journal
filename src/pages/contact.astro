---
// Contact page. Submits straight to email via Web3Forms (see
// src/lib/web3forms.ts), no mailto: handoff, with an inline success/error
// state right on the page. Needs PUBLIC_WEB3FORMS_KEY in .env (and in the
// Vercel project's env vars for this to work in production).
//
// Laid out with the form first, directly under the heading (left column,
// sticky so it stays in view), and FAQ as its own titled section on the
// right. Each question is a plain <details>/<summary> pair, closed by
// default, no JS needed for the expand/collapse itself (free keyboard
// support and semantics that way too) — see the style block for the
// plus/minus icon and divider lines.
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    question: 'Do you offer free shipping?',
    answer: "Yes, shipping is free on all orders within the US! I'm not set up for international shipping yet.",
  },
  {
    question: "What's your return and refund policy?",
    answer:
      "I accept returns within 14 days of delivery. You're responsible for the cost of shipping it back, and I'll issue a full refund once it arrives back safely.",
  },
  {
    question: 'How do I actually buy something?',
    answer:
      "Add a journal to your cart, then check out. You'll enter your shipping details, and the last step is paying through Venmo.",
  },
  {
    question: 'How long does it take to ship?',
    answer:
      "I pack and ship orders within a few days of payment going through! I'll send your tracking number as soon as it's on its way.",
  },
  {
    question: 'Can I request a custom journal?',
    answer: "Uhhhh, feel free to send a note. I'm always happy to hear what you have in mind!",
  },
  {
    question: 'What if my journal arrives damaged?',
    answer:
      "If it arrives damaged, send me a photo right away and I'll make it right, a replacement or a refund, whatever works best for you.",
  },
  {
    question: 'How do I take care of it?',
    answer: 'Treat it like any leather good. Keep it away from water, and a leather conditioner every so often will keep it supple.',
  },
];
---

<BaseLayout
  title="Contact | Hide St."
  description="Get in touch about a piece, a custom order, or just to say hello."
>
  <section class="contact">
    <div class="contact__intro">
      <p class="contact__eyebrow">Get in touch</p>
      <h1 class="contact__heading">Contact</h1>
      <p class="contact__note">
        Questions about a piece, a custom order, or just want to say hello? Send a note and I'll
        get back to you probably super quickly!
      </p>
    </div>

    <div class="contact__layout">
      <div class="contact__panel">
      <form id="contact-form" class="contact__form" novalidate>
        <div class="contact__fields">
          <div class="field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" id="contact-submit" class="contact__submit">
            <span class="contact__submit-label">Send message</span>
            <span class="contact__submit-arrow" aria-hidden="true">&rarr;</span>
          </button>

          <p id="contact-error" class="contact__error" role="status" aria-live="polite" hidden></p>
        </div>

        <div id="contact-success" class="contact__success" role="status" aria-live="polite" hidden>
          <p class="contact__success-heading">Message sent</p>
          <p class="contact__success-body">
            Thanks for reaching out. I'll get back to you soon.
          </p>
          <button type="button" id="contact-reset" class="contact__reset">Send another message</button>
        </div>
      </form>
      </div>

      <div class="contact__faq">
        <h2 class="contact__faq-heading">FAQ</h2>
        {faqs.map((faq) => (
          <details class="contact__faq-item">
            <summary class="contact__faq-question">
              <span>{faq.question}</span>
              <span class="contact__faq-icon" aria-hidden="true"></span>
            </summary>
            <p class="contact__faq-answer">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { submitToWeb3Forms } from '../lib/web3forms';

  function initContactForm() {
    const form = document.getElementById('contact-form');
    if (!(form instanceof HTMLFormElement) || form.dataset.wired) return;
    form.dataset.wired = 'true';

    const fields = form.querySelector('.contact__fields');
    const success = document.getElementById('contact-success');
    const submitBtn = document.getElementById('contact-submit');
    const errorEl = document.getElementById('contact-error');
    const resetBtn = document.getElementById('contact-reset');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get('name') || '');

      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');
      errorEl.hidden = true;

      const result = await submitToWeb3Forms({
        subject: `New message from ${name}`,
        from_name: name,
        email: String(data.get('email') || ''),
        message: String(data.get('message') || ''),
      });

      submitBtn.disabled = false;
      submitBtn.classList.remove('is-loading');

      if (result.ok) {
        form.reset();
        fields.hidden = true;
        success.hidden = false;
      } else {
        errorEl.textContent = result.message;
        errorEl.hidden = false;
      }
    });

    resetBtn?.addEventListener('click', () => {
      success.hidden = true;
      fields.hidden = false;
      form.querySelector('input, textarea')?.focus();
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 2rem) clamp(3rem, 6vw, 5rem);
  }

  .contact__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact__heading {
    margin: 0 0 0.9rem;
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 7vw, 4rem);
    line-height: 0.95;
  }

  .contact__note {
    margin: 0 0 clamp(2rem, 5vw, 3rem);
    max-width: 38ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Form on the left, directly under the heading above; FAQ as its own
     section on the right. align-items: start keeps each column sized to
     its own content instead of grid's default stretch, without it
     .contact__panel would be forced as tall as the FAQ list, and
     position: sticky below has nothing to "stick" within. */
  .contact__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .contact__faq-heading {
    margin: 0 0 1rem;
    font-family: var(--display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 1.6rem;
    line-height: 1;
  }

  .contact__faq-item {
    border-top: 1px solid var(--line-soft);
  }

  .contact__faq-item:last-child {
    border-bottom: 1px solid var(--line-soft);
  }

  /* Native <details>/<summary> — free keyboard support and screen-reader
     semantics for the expand/collapse, no JS needed. Just swapping the
     browser's own disclosure triangle for a plus/minus drawn in CSS,
     consistent with the site's other hand-drawn icons (the gallery's
     play button, the back-arrow) rather than reaching for an icon font. */
  .contact__faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .contact__faq-question::-webkit-details-marker {
    display: none;
  }

  .contact__faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 0.85rem;
    height: 0.85rem;
  }

  .contact__faq-icon::before,
  .contact__faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--ink);
    transform: translate(-50%, -50%);
  }

  .contact__faq-icon::before {
    width: 100%;
    height: 1px;
  }

  .contact__faq-icon::after {
    width: 1px;
    height: 100%;
    transition: transform 0.2s var(--ease);
  }

  /* Open: the vertical bar rotates flat onto the horizontal one, turning
     the plus into a minus. */
  .contact__faq-item[open] .contact__faq-icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__faq-icon::after {
      transition: none;
    }
  }

  .contact__faq-answer {
    margin: 0 0 1.25rem;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--muted);
  }

  /* Same hairline box as the product page's description panel
     (.info__panel) — this page is built from the same material as the
     rest of the shop, not a different template bolted on. Sticky on
     desktop, same pattern as ProductInfo.astro's info panel, so it stays
     in view while a long FAQ list scrolls past on the left. */
  .contact__panel {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }

  .contact__fields {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .field input,
  .field textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 0.7rem 0;
    border: none;
    border-bottom: 1px solid var(--line-soft);
    background: transparent;
    color: var(--ink);
    /* 16px — anything smaller makes iOS Safari zoom in on focus. */
    font-size: 1rem;
    font-family: inherit;
    resize: vertical;
    transition: border-color 0.2s var(--ease);
  }

  .field textarea {
    min-height: 7rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom-color: var(--ink);
  }

  .contact__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
    margin-top: 0.5rem;
    padding: 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #f4f4f2;
    text-transform: uppercase;
    font-family: inherit;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }

  .contact__submit-arrow {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  @media (hover: hover) {
    .contact__submit:not(:disabled):hover {
      background: #2a2a2a;
    }

    .contact__submit:not(:disabled):hover .contact__submit-arrow {
      transform: translateX(3px);
    }
  }

  .contact__submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .contact__submit.is-loading .contact__submit-label::after {
    content: '…';
  }

  .contact__error {
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--error);
  }

  .contact__success {
    text-align: center;
    padding: 1rem 0;
  }

  .contact__success-heading {
    margin: 0 0 0.5rem;
    font-family: var(--display);
    text-transform: uppercase;
    font-size: 1.5rem;
  }

  .contact__success-body {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .contact__reset {
    border: none;
    background: none;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-family: inherit;
    font-size: 0.85rem;
    color: inherit;
    cursor: pointer;
  }

  /* Same breakpoint ProductInfo.astro uses for its own sticky panel,
     one stacked column (form first, FAQ second, following DOM order),
     sticky turned off since there's no second column left for it to
     stay level with. */
  @media (max-width: 860px) {
    .contact__layout {
      grid-template-columns: 1fr;
    }

    .contact__panel {
      position: static;
    }
  }

  @media (max-width: 600px) {
    .contact__heading {
      font-size: clamp(2.2rem, 11vw, 2.8rem);
    }
  }
</style>
